#!/usr/bin/env python3
"""Per-agent model and token report for a finished workflow run.

usage:
  python3 run-report TRANSCRIPT_DIR MANIFEST [--out FILE]

TRANSCRIPT_DIR holds agent-*.meta.json (description, workflowPhase, optional
model) and agent-*.jsonl (resolved message.model and usage per line).
MANIFEST is the run manifest, used to recognise task ids. Prints JSON (or
writes it to FILE):

  {agents: [...], tiers: {<tier>: {...}}, totals: {...}, models: {...},
   unavailable: N, output_incomplete: N, escalations: N, fix_rounds: N,
   retries: N}

Anything that cannot be read or derived is the string "unavailable", never a
guess; totals sum only known values.

Effort: the workflow result file lists result.agent_settings: [{label,
model, effort}], one per agent started, in start order. Each agent takes the effort of the next unused entry with its
label (agents in start order), so a label run twice gets its two entries in
turn. Without that file, or with no matching entry or a non-string effort, an
agent's effort is "unavailable": nothing is derived from the manifest or meta.
The Workflow tool writes the transcripts to <session>/subagents/workflows/wf_<id>/
and the result to <session>/workflows/wf_<id>.json; the result file is looked
for there first, then at <TRANSCRIPT_DIR>.json beside the directory.

Output tokens: a transcript line written mid-stream carries
"stop_reason": null and the output count from the start of the stream, not
the final count. A message whose kept line has stop_reason null is
incomplete; an agent with any incomplete message has output_tokens
"unavailable" and output_tokens_min (the counts it does have, a lower
bound). Lines with no stop_reason key are taken as final. When any agent
counted in a tier (or in the run) is incomplete, that tier's (or totals')
output_tokens is "unavailable" too, since the sum would be an undercount;
output_tokens_min still sums every count there is.

Models: resolved_models maps every model that served the agent to its
message count (a fallback model shows up here even when the workflow
recorded the requested one); top-level models counts agents per model.

Exit 0 on success; 2 on a usage error or an unreadable TRANSCRIPT_DIR or
MANIFEST; 3 when a path needs converting on Windows and no Git Bash or
cygpath is found.
"""
import glob
import json
import os
import re
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _shell  # noqa: E402

UNAVAILABLE = "unavailable"
TOKEN_FIELDS = ("input_tokens", "output_tokens",
                "cache_read_input_tokens", "cache_creation_input_tokens")


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def manifest_task_ids(manifest):
    ids = []
    for t in manifest.get("prelude") or []:
        ids.append(t.get("id"))
    for lane in manifest.get("lanes") or []:
        for t in lane.get("tasks") or []:
            ids.append(t.get("id"))
    for t in manifest.get("join") or []:
        ids.append(t.get("id"))
    return {i for i in ids if isinstance(i, str)}


def agent_efforts(transcript_dir):
    """{label: [effort, ...]} from the workflow result file's
    result.agent_settings (see _shell.result_paths), in start order; {} when
    no readable result file is found."""
    result = None
    for path in _shell.result_paths(transcript_dir):
        if os.path.isfile(path):
            result = read_json(path).get("result")
            break
    settings = result.get("agent_settings") if isinstance(result, dict) else None
    efforts = {}
    for s in settings if isinstance(settings, list) else []:
        if isinstance(s, dict) and isinstance(s.get("label"), str):
            effort = s.get("effort")
            efforts.setdefault(s["label"], []).append(effort if isinstance(effort, str) and effort else UNAVAILABLE)
    return efforts


def is_task_word(word, ids):
    if word in ids:
        return True
    for m in re.finditer("-", word):
        if word[:m.start()] in ids and word[m.end():] in ids:
            return True
    return False


def parse_label(label, ids):
    """Return (task, role, retried) for an agent label."""
    retried = False
    if label.endswith(" retry"):
        label = label[:-len(" retry")].rstrip()
        retried = True
    first, _, rest = label.partition(" ")
    if rest and is_task_word(first, ids):
        return first, rest, retried, label
    return None, label, retried, label


def model_tier(model):
    if isinstance(model, str):
        low = model.lower()
        for tier in ("opus", "sonnet"):
            if tier in low:
                return tier
    return None


def read_usage(path):
    """Return (resolved_model, sums, models, complete), or (None, None, {}, True)
    when there are no usage lines.

    A transcript writes one assistant message over several lines that share
    its message.id, each repeating that message's usage (output_tokens as a
    running value). Each message counts once, with the last usage seen for
    its id (and requestId when present); lines without an id count each.
    complete is False when a counted line has stop_reason null (its
    output_tokens is a mid-stream value).
    """
    model = None
    models = {}
    counted = set()
    usages = {}
    anonymous = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                msg = obj.get("message") if isinstance(obj, dict) else None
                if not isinstance(msg, dict):
                    continue
                usage = msg.get("usage")
                if not isinstance(usage, dict):
                    continue
                final = not ("stop_reason" in msg and msg["stop_reason"] is None)
                mid = msg.get("id")
                rid = obj.get("requestId")
                key = (mid, rid if isinstance(rid, str) else None) if isinstance(mid, str) and mid else None
                if isinstance(msg.get("model"), str):
                    model = msg["model"]
                    # Each message counts once per model, on the first line that names it.
                    if key is None or (key, model) not in counted:
                        models[model] = models.get(model, 0) + 1
                        if key is not None:
                            counted.add((key, model))
                if key is not None:
                    usages[key] = (usage, final)
                else:
                    anonymous.append((usage, final))
    except OSError:
        return None, None, {}, True
    if not usages and not anonymous:
        return None, None, {}, True
    sums = {k: 0 for k in TOKEN_FIELDS}
    complete = True
    for usage, final in list(usages.values()) + anonymous:
        complete = complete and final
        for k in TOKEN_FIELDS:
            v = usage.get(k)
            if isinstance(v, int) and not isinstance(v, bool):
                sums[k] += v
    return model, sums, models, complete


def first_timestamp(path):
    """First timestamp field in a jsonl transcript, or None."""
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                ts = obj.get("timestamp") if isinstance(obj, dict) else None
                if isinstance(ts, str) and ts:
                    return ts
    except OSError:
        pass
    return None


def start_key(meta_path):
    """Chronological sort key: first transcript timestamp, else meta mtime."""
    from datetime import datetime, timezone
    ts = first_timestamp(meta_path[:-len(".meta.json")] + ".jsonl")
    if ts:
        try:
            return (datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp(), meta_path)
        except ValueError:
            pass
    try:
        return (os.path.getmtime(meta_path), meta_path)
    except OSError:
        return (0.0, meta_path)


def blank_bucket():
    b = {k: 0 for k in TOKEN_FIELDS}
    b["output_tokens_min"] = 0
    b["agents"] = 0
    return b


def build(transcript_dir, manifest):
    ids = manifest_task_ids(manifest)
    efforts = agent_efforts(transcript_dir)
    metas = sorted(glob.glob(os.path.join(transcript_dir, "agent-*.meta.json")), key=start_key)
    agents = []
    for meta_path in metas:
        stem = meta_path[:-len(".meta.json")]
        meta = read_json(meta_path)
        label = next((meta[k] for k in ("description", "label")
                      if isinstance(meta.get(k), str)), "")
        phase = next((meta[k] for k in ("workflowPhase", "phase")
                      if isinstance(meta.get(k), str)), None)
        task, role, retried, base_label = parse_label(label, ids)
        requested = meta.get("model") if isinstance(meta.get("model"), str) else None
        resolved, sums, models, complete = read_usage(stem + ".jsonl")
        tier = model_tier(resolved) or model_tier(requested) or UNAVAILABLE
        queue = efforts.get(label)
        effort = queue.pop(0) if queue else UNAVAILABLE
        entry = {
            "label": label,
            "phase": phase,
            "task": task,
            "role": role,
            "tier": tier,
            "requested_model": requested if requested else UNAVAILABLE,
            "resolved_model": resolved if resolved else UNAVAILABLE,
            "effort": effort,
        }
        entry["resolved_models"] = models
        for k in TOKEN_FIELDS:
            entry[k] = sums[k] if sums is not None else UNAVAILABLE
        entry["output_tokens_min"] = sums["output_tokens"] if sums is not None else UNAVAILABLE
        if sums is not None and not complete:
            entry["output_tokens"] = UNAVAILABLE
        entry["_base"] = base_label
        entry["_retried"] = retried
        agents.append(entry)

    tiers = {}
    totals = blank_bucket()
    unavailable = 0
    output_incomplete = 0
    models = {}
    retries = 0
    last_model = {}  # stripped label -> (tier, model) of its latest run
    for a in agents:
        tier = a["tier"]
        bucket = tiers.setdefault(tier, blank_bucket())
        bucket["escalations"] = bucket.get("escalations", 0)
        bucket["fix_rounds"] = bucket.get("fix_rounds", 0)
        bucket["agents"] += 1
        totals["agents"] += 1
        for m in a["resolved_models"]:
            models[m] = models.get(m, 0) + 1
        if a["input_tokens"] == UNAVAILABLE:
            unavailable += 1
        else:
            if a["output_tokens"] == UNAVAILABLE:
                output_incomplete += 1
            for k in TOKEN_FIELDS + ("output_tokens_min",):
                if a[k] != UNAVAILABLE:
                    bucket[k] += a[k]
                    totals[k] += a[k]
        if a["_retried"]:
            retries += 1
        if a["task"] is not None and re.match(r"^fix \d+$", a["role"]):
            bucket["fix_rounds"] += 1
        # An escalation: the same label running again at a different model;
        # counted under the earlier tier.
        model = a["resolved_model"] if a["resolved_model"] != UNAVAILABLE else a["requested_model"]
        prev = last_model.get(a["_base"])
        if prev is not None and model != UNAVAILABLE and prev[1] != UNAVAILABLE \
                and model_tier(model) != model_tier(prev[1]):
            tiers[prev[0]]["escalations"] += 1
        last_model[a["_base"]] = (tier, model)

    for a in agents:
        if a["output_tokens"] == UNAVAILABLE and a["input_tokens"] != UNAVAILABLE:
            tiers[a["tier"]]["output_tokens"] = UNAVAILABLE
            totals["output_tokens"] = UNAVAILABLE
        del a["_base"]
        del a["_retried"]
    return {
        "agents": agents,
        "tiers": tiers,
        "totals": totals,
        "models": models,
        "unavailable": unavailable,
        "output_incomplete": output_incomplete,
        "escalations": sum(b["escalations"] for b in tiers.values()),
        "fix_rounds": sum(b["fix_rounds"] for b in tiers.values()),
        "retries": retries,
    }


def main(argv):
    _shell.setup_io()
    args = argv[1:]
    out = None
    if "--out" in args:
        i = args.index("--out")
        if i + 1 >= len(args):
            print("run-report: --out needs a file", file=sys.stderr)
            return 2
        out = args[i + 1]
        del args[i:i + 2]
    if len(args) != 2:
        print("usage: run-report TRANSCRIPT_DIR MANIFEST [--out FILE]", file=sys.stderr)
        return 2
    try:
        transcript_dir, manifest_path = (_shell.native_path(a) for a in args)
        if out:
            out = _shell.native_path(out)
    except _shell.BashNotFound as e:
        print(f"run-report: {e}", file=sys.stderr)
        return 3
    if not os.path.isdir(transcript_dir):
        print(f"run-report: not a directory: {transcript_dir}", file=sys.stderr)
        return 2
    try:
        with open(manifest_path, encoding="utf-8") as f:
            manifest = json.load(f)
    except (OSError, ValueError) as e:
        print(f"run-report: cannot read manifest: {e}", file=sys.stderr)
        return 2
    text = json.dumps(build(transcript_dir, manifest if isinstance(manifest, dict) else {}), indent=2) + "\n"
    if out:
        _shell.write_text(out, text)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
