#!/usr/bin/env python3
"""Opening bookkeeping for an implementer or reviewer in one call.

usage: start-task DIR PLAN [--sync BRANCH] [--package SCRIPT BASE HEAD OUT]
                  [--artifacts ROOT] [--record-start LEDGER_DIR LANE BASE]
                  [--scope BASE HEAD (--declared PATH [--declared PATH ...] [--owners FILE]
                                      | --declared-from-owners N:HHHHHHHH --owners FILE)]
                  [--rulings LEDGER_DIR LANE]
                  [--unit-branch NAME SHA --run-id RUN [--setup COMMAND ...]]
                  [--restart]
                  --brief TASK_ID OUT [--brief TASK_ID OUT ...]
                  [--also TASK_ID PRODUCER_ID ...]

In order:
  --unit-branch  a join wave unit (1.6.5) runs on its own branch NAME
             (pl-<run_id>-u-<unit id>) in a lane worktree DIR. When DIR is
             already on NAME (a retry of the same unit) nothing changes
             ("kept"). Otherwise DIR's uncommitted changes, if any, are
             saved under refs/parallel-lanes/RUN/abandoned/ (the snapshot
             setup makes of a reused worktree, _snapshot) and discarded,
             and NAME is checked out ("switched"), or created at SHA when
             it does not exist ("created"; a SHA that is not a commit exits
             3 before anything changes). A NAME an earlier launch left that
             is not built on SHA has its head saved under the abandoned refs
             (refs/parallel-lanes/RUN/abandoned/NAME-<stamp>) and is made
             again at SHA ("recreated"). Then each --setup COMMAND runs
             with bash -c in DIR, in order (the feature checkout's setup:
             the worktree's environment predates the merged lanes); one
             that fails exits 1. Needs --run-id; not with --sync.
  --sync     git -C DIR merge --ff-only BRANCH (a failure exits 3 and writes
             no brief).
  --brief    scripts/task-brief PLAN TASK_ID OUT for each pair, in the given
             order (a failure exits with its code and message). Each
             --also TASK_ID PRODUCER_ID adds '--also PRODUCER_ID' to the
             task-brief call for that TASK_ID, in the given order; an --also
             whose TASK_ID has no --brief exits 2 before any work.
  --package  mkdir -p the parent of OUT, then bash SCRIPT PLAN BASE HEAD OUT
             with DIR as the working directory (a failure exits 1). bash is
             the one _shell.find_bash resolves (Git Bash on Windows, never
             the WSL launcher), found before anything else is done.
  --artifacts  every brief OUT (task-brief --root ROOT) and the package OUT
             must resolve, symlinks included, to a path inside ROOT (the run's
             ledger directory); otherwise exit 3 before anything is written.
  --record-start  once everything above succeeded, appends {"task": TASK_ID,
             "event": "started", "base": <full sha of BASE>} for every --brief
             TASK_ID to LEDGER_DIR/LANE.jsonl (scripts/ledger append): the
             task base, recorded before the implementer writes. BASE must be
             a commit in DIR, else exit 3 before anything is written. With
             --unit-branch the event also has "dir" (DIR, in the C:/ form on
             Windows) and "unit_branch"; with --restart (which needs
             --record-start), "restart": true: a join unit begun again from
             the feature tip, whose earlier attempt the ledger then drops.
  --scope    prints the paths git diff --name-only --no-renames BASE HEAD
             (in DIR) changes that are not a --declared PATH (normalized and
             case-insensitive; a rename changes both paths), one per line
             after a "===== files changed outside the task's Files list ====="
             line, or "(none)". --scope with neither --declared nor
             --declared-from-owners exits 2. --declared-from-owners
             N:HHHHHHHH (1.6.6) stands for the --declared list: the --brief
             tasks' `declared` lists in FILE, in --brief order, each exact
             string once, whose fingerprint (_owners.fingerprint) must be
             N:HHHHHHHH. It needs --scope and --owners, does not go with
             --declared, and a value not of that form exits 2. FILE is
             read right after the --artifacts check, before any git work.
             When it is missing or unreadable, or the fingerprint differs,
             the section is the one line "(could not build the list: the
             run's owner map does not match this unit's Files list; judge
             scope from the brief)", everything else runs as before and the
             exit stays 0. With --owners FILE (the ledger's owners.json,
             written by setup) each path carries what it is, seen from the
             --brief tasks: "(owned by
             X, earlier in the run)", "(owned by X, another lane, running
             alongside)", "(owned by X, later)" or "(no task owns it)"; a
             changed declared path that another task also lists follows as
             "(in your Files list; also in X's Files)". Under --declared, a
             missing FILE prints the plain list and an unreadable one exits 3.
  --rulings  prints `ledger rulings LEDGER_DIR --lane LANE` (LANE "-": every
             ruling) under a "===== rulings in force =====" line, after the
             briefs; when that fails, one "(could not read the rulings: ...)"
             line instead.
Relative SCRIPT, PLAN and OUT paths resolve against the caller's directory.
On Windows every path argument may be given in any form (C:\\x, /c/x,
/tmp/x) and is used in the C:/... form.
GIT_DIR, GIT_WORK_TREE, GIT_INDEX_FILE, GIT_OBJECT_DIRECTORY and
GIT_COMMON_DIR are removed from the environment of git, task-brief and the
package script, so DIR alone names the repository.

stdout, only on success:
  branch: <abbrev-ref of DIR>
  head: <full sha of DIR's HEAD after any sync>
  unit branch: NAME (created|switched|recreated|kept)  (--unit-branch)
  saved: <ref> (<commit>)              per snapshot --unit-branch made
  ===== brief <TASK_ID>: <OUT> =====   then the brief text, per brief
  ===== rulings in force =====         then the rulings (--rulings)
  ===== review package =====           then the script's stdout (--package)
  ===== files changed outside ... ===== then the paths (--scope)

Exit 0 on success; 1 if git rev-parse HEAD fails after the sync, a written
brief cannot be read, the package script fails, or the --scope diff fails; 2
on usage error; 3 if DIR is not a git worktree, the fast-forward fails, an OUT
is outside --artifacts, the --record-start BASE is not a commit, or no bash
can be found (the message names CLAUDE_CODE_GIT_BASH_PATH);
task-brief's code if a brief fails, the ledger's if a started append fails.
"""

import argparse
import datetime
import json
import os
import posixpath
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, HERE)
import _brief  # noqa: E402
import _owners  # noqa: E402
import _shell  # noqa: E402
import _snapshot  # noqa: E402
# Variables that would point git at another repo than the one named.
GIT_REDIRECTS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
                 "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR")
ENV = {k: v for k, v in os.environ.items() if k not in GIT_REDIRECTS}
# The same forms as the ledger's UNIT_BRANCH and validate.js' runIdPattern.
UNIT_BRANCH = re.compile(r"^pl-[a-z0-9-]+-u-[A-Za-z0-9_][A-Za-z0-9._-]*$")
RUN_ID = re.compile(r"^[a-z0-9-]+$")
# The scope section under --declared-from-owners when the owner map does not
# give the unit's declared list.
UNMATCHED = ("(could not build the list: the run's owner map does not match this unit's Files list; "
             "judge scope from the brief)")


def fail(code, message):
    print(f"start-task: {message}", file=sys.stderr)
    sys.exit(code)


def git(directory, *args):
    return subprocess.run(
        ["git", "-C", directory, *args], capture_output=True, text=True, encoding="utf-8",
        errors="surrogateescape", env=ENV
    )


def rev_parse(code, directory, *args):
    res = git(directory, "rev-parse", *args)
    if res.returncode != 0:
        fail(code, f"git rev-parse {' '.join(args)} failed in {directory!r}: {res.stderr.strip()}")
    return res.stdout.strip()


def parse(argv):
    parser = argparse.ArgumentParser(prog="start-task")
    parser.add_argument("dir", metavar="DIR")
    parser.add_argument("plan", metavar="PLAN")
    parser.add_argument("--sync", metavar="BRANCH")
    parser.add_argument(
        "--package", nargs=4, metavar=("SCRIPT", "BASE", "HEAD", "OUT")
    )
    parser.add_argument(
        "--brief", nargs=2, action="append", required=True, metavar=("TASK_ID", "OUT")
    )
    parser.add_argument(
        "--also", nargs=2, action="append", default=[], metavar=("TASK_ID", "PRODUCER_ID")
    )
    parser.add_argument("--artifacts", metavar="ROOT")
    parser.add_argument("--record-start", nargs=3, metavar=("LEDGER_DIR", "LANE", "BASE"))
    parser.add_argument("--scope", nargs=2, metavar=("BASE", "HEAD"))
    parser.add_argument("--declared", action="append", default=[], metavar="PATH")
    parser.add_argument("--owners", metavar="FILE")
    parser.add_argument("--declared-from-owners", metavar="N:HHHHHHHH")
    parser.add_argument("--rulings", nargs=2, metavar=("LEDGER_DIR", "LANE"))
    parser.add_argument("--unit-branch", nargs=2, metavar=("NAME", "SHA"))
    parser.add_argument("--run-id", metavar="RUN")
    parser.add_argument("--setup", action="append", default=[], metavar="COMMAND")
    parser.add_argument("--restart", action="store_true")
    args = parser.parse_args(argv)
    if args.unit_branch is not None:
        if args.run_id is None or not RUN_ID.fullmatch(args.run_id):
            parser.error("--unit-branch needs a --run-id of lowercase letters, digits and dashes")
        if not UNIT_BRANCH.fullmatch(args.unit_branch[0]):
            parser.error(f"--unit-branch {args.unit_branch[0]!r} is not of the form pl-<run_id>-u-<unit id>")
        if args.sync is not None:
            parser.error("--unit-branch and --sync do not go together")
    elif args.setup:
        parser.error("--setup needs --unit-branch")
    if args.restart and args.record_start is None:
        parser.error("--restart needs --record-start")
    if args.declared_from_owners is not None:
        if args.scope is None:
            parser.error("--declared-from-owners needs --scope")
        if args.owners is None:
            parser.error("--declared-from-owners needs --owners")
        if args.declared:
            parser.error("--declared-from-owners and --declared do not go together")
        if not _owners.FINGERPRINT.fullmatch(args.declared_from_owners):
            parser.error(f"--declared-from-owners {args.declared_from_owners!r} is not of the form N:HHHHHHHH")
    if args.owners is not None and args.scope is None:
        parser.error("--owners needs --scope")
    if args.scope is not None and not args.declared and args.declared_from_owners is None:
        parser.error("--scope needs at least one --declared PATH, or --declared-from-owners")
    for task_id, _ in args.brief:
        if not _brief.is_safe_id(task_id):
            parser.error(f"unsafe task id {task_id!r}")
    native = _shell.native_path
    args.dir = native(args.dir)
    args.plan = native(args.plan)
    args.brief = [[task_id, native(out)] for task_id, out in args.brief]
    if args.package is not None:
        args.package = [native(args.package[0]), args.package[1], args.package[2], native(args.package[3])]
    if args.artifacts is not None:
        args.artifacts = native(args.artifacts)
    if args.record_start is not None:
        args.record_start = [native(args.record_start[0]), args.record_start[1], args.record_start[2]]
    if args.owners is not None:
        args.owners = native(args.owners)
    if args.rulings is not None:
        args.rulings = [native(args.rulings[0]), args.rulings[1]]
    briefed = {task_id for task_id, _ in args.brief}
    for task_id, _ in args.also:
        if task_id not in briefed:
            parser.error(f"--also names task {task_id!r}, which has no --brief")
    return args


def contained(path, root):
    """As task-brief: path, existing ancestors' symlinks resolved, is inside root."""
    root = os.path.realpath(root)
    path = os.path.abspath(path)
    head, tail = path, []
    while not os.path.lexists(head) and head != os.path.dirname(head):
        head, name = os.path.split(head)
        tail.insert(0, name)
    resolved = os.path.join(os.path.realpath(head), *tail)
    return os.path.commonpath([resolved, root]) == root


def path_key(path):
    """A project-relative path as validate.js and the ledger compare it."""
    return posixpath.normpath(path).lower()


def switch_unit_branch(directory, args):
    """Put DIR on the unit branch (--unit-branch NAME SHA) and run the
    --setup commands there. Returns (NAME, the output lines)."""
    name, sha = args.unit_branch
    current = rev_parse(3, directory, "--abbrev-ref", "HEAD")
    lines, preserved = [], []
    if current == name:
        state = "kept"
    else:
        res = git(directory, "rev-parse", "--verify", "--quiet", "--end-of-options", f"{sha}^{{commit}}")
        if res.returncode != 0 or not res.stdout.strip():
            fail(3, f"--unit-branch start {sha!r} is not a commit in {directory!r}; nothing changed")
        start = res.stdout.strip()
        old = git(directory, "rev-parse", "--verify", "--quiet", f"refs/heads/{name}")
        exists = old.returncode == 0
        # A branch an earlier launch left that is not built on SHA (the tip
        # moved since): its head is kept under the abandoned refs and the
        # branch is made again at SHA, so the unit never builds on a stale base.
        stale = exists and git(directory, "merge-base", "--is-ancestor", start, old.stdout.strip()).returncode != 0
        try:
            _snapshot.discard_changes(directory, args.run_id, [], preserved, by="start-task")
        except _snapshot.Failure as e:
            fail(e.code, str(e))
        if stale:
            stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
            ref = f"refs/parallel-lanes/{args.run_id}/abandoned/{name}-{stamp}"
            if git(directory, "update-ref", ref, old.stdout.strip()).returncode != 0:
                fail(1, f"saving the head of {name!r} under {ref} failed")
            preserved.append({"ref": ref, "commit": old.stdout.strip()})
        res = git(directory, "checkout", "-q", name) if exists and not stale else \
            git(directory, "checkout", "-q", "-B" if stale else "-b", name, start)
        if res.returncode != 0:
            fail(1, f"checking out {name!r} in {directory!r} failed: {res.stderr.strip()}")
        state = "recreated" if stale else ("switched" if exists else "created")
    lines.append(f"unit branch: {name} ({state})\n")
    lines += [f"saved: {p['ref']} ({p['commit']})\n" for p in preserved]
    for command in args.setup:
        res = subprocess.run(_shell.bash_argv("-c", command), cwd=directory, env=ENV)
        if res.returncode != 0:
            fail(1, f"setup command {command!r} exited {res.returncode} in {directory!r}")
    return name, lines


def scope_list(directory, args):
    """The --scope section's lines: the changed paths outside args.declared,
    annotated from the owner map when there is one."""
    res = git(directory, "-c", "core.quotePath=false", "diff", "--name-only", "--no-renames",
              "--end-of-options", *args.scope)
    if res.returncode != 0:
        fail(1, f"git diff {' '.join(args.scope)} failed in {directory!r}: {res.stderr.strip()}")
    declared = {path_key(p) for p in args.declared}
    changed = [p for p in res.stdout.splitlines() if p]
    outside = sorted(p for p in changed if path_key(p) not in declared)
    lines = outside
    if args.owners is not None and os.path.exists(args.owners):
        # A ledger set up before 1.6.3 has no owner map: the plain list.
        try:
            owners = _owners.load(args.owners)
        except (OSError, ValueError) as e:
            if args.declared_from_owners is not None:
                return UNMATCHED
            fail(3, f"cannot read the owner map {args.owners!r}: {e}")
        unit = [task_id for task_id, _ in args.brief]
        shared = sorted(p for p in changed if path_key(p) in declared
                        and any(t not in unit for t in owners["files"].get(_owners.path_key(p), [])))
        lines = [f"{p} ({_owners.annotate(owners, unit, p)})" for p in outside + shared]
    elif args.declared_from_owners is not None:
        # Read at the start, gone now: never the plain list.
        return UNMATCHED
    return "\n".join(lines) if lines else "(none)"


def main(argv):
    _shell.setup_io()
    try:
        run(parse(argv))
    except _shell.BashNotFound as e:
        fail(3, str(e))


def run(args):
    if args.package is not None:
        # Found before any change: a missing bash leaves nothing half done.
        _shell.find_bash()
    directory = args.dir
    if args.artifacts is not None:
        outs = [path for _, path in args.brief] + ([args.package[3]] if args.package else [])
        for path in outs:
            if os.path.islink(path) or not contained(path, args.artifacts):
                fail(3, f"artifact path {path!r} is outside {args.artifacts!r}; nothing written")
    # The scope list is advisory: an owner map that is missing, unreadable or
    # does not match the engine's fingerprint never stops the start.
    unmatched = False
    if args.declared_from_owners is not None:
        try:
            args.declared = _owners.owners_declared(
                args.owners, [task_id for task_id, _ in args.brief], args.declared_from_owners)
        except ValueError:
            unmatched = True
    branch = rev_parse(3, directory, "--abbrev-ref", "HEAD")
    start_base = None
    if args.record_start is not None:
        res = git(directory, "rev-parse", "--verify", "--quiet", "--end-of-options",
                  f"{args.record_start[2]}^{{commit}}")
        if res.returncode != 0 or not res.stdout.strip():
            fail(3, f"--record-start base {args.record_start[2]!r} is not a commit in {directory!r}; nothing written")
        start_base = res.stdout.strip()

    unit_lines = []
    if args.unit_branch is not None:
        branch, unit_lines = switch_unit_branch(directory, args)

    if args.sync is not None:
        res = git(directory, "merge", "--ff-only", "--end-of-options", args.sync)
        if res.returncode != 0:
            detail = (res.stderr or res.stdout).strip()
            fail(3, f"fast-forward of {directory!r} to {args.sync!r} failed: {detail}")
    head = rev_parse(1, directory, "HEAD")

    out = [f"branch: {branch}\n", f"head: {head}\n", *unit_lines]
    plan = _shell.native_path(os.path.abspath(args.plan))
    for task_id, path in args.brief:
        extra = [a for t, producer in args.also if t == task_id for a in ("--also", producer)]
        if args.artifacts is not None:
            extra += ["--root", args.artifacts]
        res = subprocess.run(
            [sys.executable, os.path.join(HERE, "task-brief"), plan, task_id, path, *extra],
            env=ENV,
        )
        if res.returncode != 0:
            sys.exit(res.returncode)
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            fail(1, f"cannot read brief {path!r}: {e}")
        out.append(f"===== brief {task_id}: {path} =====\n{text}")

    if args.rulings is not None:
        ledger_dir, lane = args.rulings
        res = subprocess.run([sys.executable, os.path.join(HERE, "ledger"), "rulings", ledger_dir,
                              *([] if lane == "-" else ["--lane", lane])],
                             env=ENV, capture_output=True, text=True, encoding="utf-8", errors="replace")
        # An unreadable ledger never keeps the agent from starting: it sees why.
        text = res.stdout if res.returncode == 0 else \
            f"(could not read the rulings: {(res.stderr.strip().splitlines() or ['ledger failed'])[-1]})\n"
        out.append(f"===== rulings in force =====\n{text}")

    if args.package is not None:
        script, base, head_ref, package_out = args.package
        script = _shell.native_path(os.path.abspath(script))
        package_out = _shell.native_path(os.path.abspath(package_out))
        os.makedirs(os.path.dirname(package_out), exist_ok=True)
        res = subprocess.run(
            _shell.bash_argv(script, plan, base, head_ref, package_out),
            cwd=directory,
            env=ENV,
            stdout=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
        )
        if res.returncode != 0:
            fail(1, f"package script {script!r} exited {res.returncode}")
        out.append(f"===== review package =====\n{res.stdout}")

    if args.scope is not None:
        out.append("===== files changed outside the task's Files list =====\n"
                   + (UNMATCHED if unmatched else scope_list(directory, args)) + "\n")

    if start_base is not None:
        ledger_dir, lane, _ = args.record_start
        for task_id, _ in args.brief:
            event = {"task": task_id, "event": "started", "base": start_base}
            if args.unit_branch is not None:
                event.update({"dir": directory, "unit_branch": args.unit_branch[0]})
            if args.restart:
                event["restart"] = True
            entry = json.dumps(event)
            res = subprocess.run([sys.executable, os.path.join(HERE, "ledger"), "append", ledger_dir, lane, entry],
                                 env=ENV, capture_output=True, text=True, encoding="utf-8", errors="replace")
            if res.returncode != 0:
                sys.stderr.write(res.stderr)
                sys.exit(res.returncode)

    sys.stdout.write("".join(out))


if __name__ == "__main__":
    main(sys.argv[1:])
