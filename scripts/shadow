#!/usr/bin/env bash
# Private git repo kept outside a project folder that is not a git repo.
#
# usage:
#   shadow init PROJECT [--force]
#   shadow preview GITDIR PROJECT REF
#   shadow writeback GITDIR PROJECT REF
#   shadow remove GITDIR
#
# init creates the shadow git dir <base>/<first 16 hex of sha256(abs PROJECT)>
# (mode 0700) and prints its path. <base> is $PL_SHADOW_BASE, default
# ${CLAUDE_CONFIG_DIR:-~/.claude}/parallel-lanes/shadow. The repo is bare; git runs against the
# project only with --work-tree, so the project never gains a .git or any
# other file. Without a project .gitignore, info/exclude gets the built-in
# excludes. Refuses (exit 3) a project with more than $PL_SHADOW_MAX_FILES
# (default 200000) files or $PL_SHADOW_MAX_BYTES (default 500 MiB) unless
# --force. Commits the project on branch pl-base and records that commit in
# <gitdir>/pl-baseline and the project path in <gitdir>/pl-project. If the
# shadow already exists, init prints it and keeps its baseline (resume).
#
# The shadow repo's config has core.autocrlf=false, so lane worktrees check
# out the committed bytes whatever the user or system config says. init,
# preview and writeback set it again on an existing shadow, which repairs a
# shadow made without it.
#
# init also writes <gitdir>/info/attributes with
#   * -text -eol -filter -ident -working-tree-encoding
# before the baseline commit. info/attributes outranks the project's
# .gitattributes at any depth and the user's core.attributesFile, and lane
# worktrees share it, so the baseline, the worktrees and every commit hold
# the project's exact bytes (merge and diff attributes still apply). An
# existing shadow is not given it: its baseline and worktrees were made with
# the project's attributes, and adding it mid-run would make every
# normalised file look modified. preview and writeback hash project files
# with the shadow's attributes, which matches how either kind of baseline
# was made.
#
# preview prints
#   {"conflicts":[...],"add":[...],"modify":[...],"delete":[...],"skipped":[...]}.
# add/modify/delete list every path REF changes relative to the baseline,
# except new paths matched by the exclude rules, which are listed in skipped
# and never written. conflicts lists those paths whose current project state
# differs from the baseline (edited, deleted, created, or reached through a
# replaced parent directory).
#
# writeback refuses (exit 3, reasons on stderr, nothing written) when preview
# has conflicts or when a path it would write or delete is not writable (the
# file itself, or the directory that would gain or lose it). Otherwise it
# deletes the paths REF deleted, writes the paths REF added or modified,
# prints the preview JSON, and touches no other file. If a write still fails
# midway (disk full, a race), it stops with exit 3 and lists on stderr the
# paths already written.
#
# remove deletes GITDIR after checking it is a shadow directly under <base>.
#
# Under Git Bash every path printed (GITDIR and the paths in messages) takes
# the C:/ form; the script itself works with the bash form of each path, so
# pl-project records the bash form.
#
# Exit 0 on success; 2 on usage error or bad argument; 3 on a refused or
# unsafe condition.
set -euo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/_paths.sh"

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR

BASE="${PL_SHADOW_BASE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/parallel-lanes/shadow}"
MAX_FILES="${PL_SHADOW_MAX_FILES:-200000}"
MAX_BYTES="${PL_SHADOW_MAX_BYTES:-524288000}"
BUILTIN_EXCLUDES=(node_modules/ .venv/ venv/ dist/ build/ __pycache__/ .pytest_cache/
  .mypy_cache/ .cache/ .next/ target/ '*.pyc')

usage() {
  cat >&2 <<'EOF'
usage: shadow init PROJECT [--force]
       shadow preview GITDIR PROJECT REF
       shadow writeback GITDIR PROJECT REF
       shadow remove GITDIR
EOF
  exit 2
}

bad_arg() {
  echo "shadow: $1" >&2
  exit 2
}

refuse() {
  echo "shadow: $1" >&2
  exit 3
}

# git with no hooks: global or repo hooks would run with the project as cwd.
git_nohooks() {
  git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}

# git against the shadow repo with the project as its work tree. Line ending
# conversion is pinned off so blobs hold the project's exact bytes.
g() {
  git_nohooks -c core.autocrlf=false -c core.safecrlf=false \
    --git-dir="$GITDIR" --work-tree="$PROJECT" "$@"
}

# Pin line ending conversion off in the shadow repo's own config, which its
# lane worktrees share. A shadow made before 1.3.1 lacked the pin: its lane
# worktrees, checked out under core.autocrlf=true, hold CRLF copies of LF
# blobs, so once the pin is set git sees every text file in them as
# modified. scripts/setup then reports them as discarded edits and heals the
# worktrees (it saves a preserved ref first), which is expected once.
pin_line_endings() {
  git_nohooks --git-dir="$GITDIR" config core.autocrlf false
}

sha256_16() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -c1-16
  else
    shasum -a 256 | cut -c1-16
  fi
}

# --- init -------------------------------------------------------------------

file_sizes() {
  if stat -c %s / >/dev/null 2>&1; then
    xargs -0 stat -c %s --
  else
    xargs -0 stat -f %z --
  fi
}

cmd_init() {
  local project_arg="" force=0 arg
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      -*) usage ;;
      *)
        [ -z "$project_arg" ] || usage
        project_arg="$arg"
        ;;
    esac
  done
  [ -n "$project_arg" ] || usage
  [ -d "$project_arg" ] || bad_arg "not a directory: $project_arg"
  [[ "$MAX_FILES" =~ ^[0-9]+$ ]] || bad_arg "PL_SHADOW_MAX_FILES must be a number"
  [[ "$MAX_BYTES" =~ ^[0-9]+$ ]] || bad_arg "PL_SHADOW_MAX_BYTES must be a number"

  umask 077
  PROJECT="$(cd -- "$project_arg" && pwd -P)"
  mkdir -p -- "$BASE"
  local base_abs
  base_abs="$(cd -- "$BASE" && pwd -P)"
  case "$base_abs/" in
    "$PROJECT"/*) refuse "shadow base $(native "$base_abs") is inside the project $(native "$PROJECT")" ;;
  esac
  GITDIR="$base_abs/$(printf '%s' "$PROJECT" | sha256_16)"

  if [ -f "$GITDIR/pl-baseline" ]; then
    [ "$(cat "$GITDIR/pl-project")" = "$PROJECT" ] ||
      refuse "$(native "$GITDIR") belongs to another project"
    pin_line_endings
    native "$GITDIR"
    return 0
  fi

  # A directory without pl-baseline is a failed earlier init.
  rm -rf -- "$GITDIR"
  trap 'rm -rf -- "$GITDIR"' EXIT
  # An empty --template copies no template hooks into the shadow.
  git_nohooks init -q --bare --template= -b pl-base "$GITDIR"
  chmod 700 "$GITDIR"
  pin_line_endings
  mkdir -p -- "$GITDIR/info"
  if [ -f "$PROJECT/.gitignore" ]; then
    printf '# project has a .gitignore; no built-in excludes\n' >"$GITDIR/info/exclude"
  else
    printf '%s\n' "${BUILTIN_EXCLUDES[@]}" >"$GITDIR/info/exclude"
  fi
  # Keep exact bytes whatever the project's or the user's attributes say.
  printf '* -text -eol -filter -ident -working-tree-encoding\n' >"$GITDIR/info/attributes"

  cd -- "$PROJECT"
  local list="$GITDIR/pl-files" count bytes=0
  g ls-files --others --exclude-standard -z >"$list"
  count="$(tr -cd '\0' <"$list" | wc -c | tr -d ' ')"
  if [ "$force" -eq 0 ]; then
    if [ "$count" -gt "$MAX_FILES" ]; then
      refuse "project has $count files (limit $MAX_FILES); rerun with --force to shadow it anyway"
    fi
    if [ "$count" -gt 0 ]; then
      bytes="$(file_sizes <"$list" | awk '{ s += $1 } END { printf "%d", s }')"
    fi
    if [ "$bytes" -gt "$MAX_BYTES" ]; then
      refuse "project has $bytes bytes (limit $MAX_BYTES); rerun with --force to shadow it anyway"
    fi
  fi
  rm -f -- "$list"

  g add -A
  g -c user.name=parallel-lanes -c user.email=parallel-lanes@localhost \
    -c commit.gpgsign=false commit -q --no-verify --allow-empty -m 'pl-base: project baseline'
  # pl-baseline is written last: it marks a complete shadow.
  printf '%s\n' "$PROJECT" >"$GITDIR/pl-project"
  g rev-parse HEAD >"$GITDIR/pl-baseline"
  trap - EXIT
  native "$GITDIR"
}

# --- preview and writeback --------------------------------------------------

# Sets GITDIR, PROJECT, BASELINE, TARGET from GITDIR PROJECT REF arguments.
load_shadow() {
  [ -d "$1" ] && [ -f "$1/pl-baseline" ] && [ -f "$1/pl-project" ] ||
    bad_arg "not a shadow git dir: $1"
  [ -d "$2" ] || bad_arg "not a directory: $2"
  GITDIR="$(cd -- "$1" && pwd -P)"
  PROJECT="$(cd -- "$2" && pwd -P)"
  local recorded
  recorded="$(cat "$GITDIR/pl-project")"
  [ "$recorded" = "$PROJECT" ] ||
    refuse "$(native "$GITDIR") is the shadow of $(native "$recorded"), not $(native "$PROJECT")"
  pin_line_endings
  BASELINE="$(g rev-parse --verify --quiet "$(cat "$GITDIR/pl-baseline")^{commit}")" ||
    refuse "baseline commit missing from $(native "$GITDIR")"
  TARGET="$(g rev-parse --verify --quiet --end-of-options "$3^{commit}")" ||
    bad_arg "unknown ref: $3"
  cd -- "$PROJECT"
}

# Reject paths that could leave the project or reach a git dir.
check_path() {
  case "/$1/" in
    //* | */../* | */./* | *//*) refuse "unsafe path in $TARGET: $1" ;;
    */.[Gg][Ii][Tt]/*) refuse "unsafe path in $TARGET: $1" ;;
  esac
}

# Success when PATH (in the project) no longer matches baseline MODE and SHA.
differs_from_baseline() {
  local p="$PROJECT/$1" mode="$2" sha="$3" current
  case "$mode" in
    120000)
      [ -L "$p" ] || return 0
      current="$(printf '%s' "$(readlink -- "$p")" | g hash-object --stdin)"
      ;;
    100644 | 100755)
      [ -f "$p" ] && [ ! -L "$p" ] || return 0
      if [ "$mode" = 100755 ]; then
        [ -x "$p" ] || return 0
      else
        [ ! -x "$p" ] || return 0
      fi
      # Hash as git add did: with the shadow's attributes, looked up by
      # the project-relative path.
      current="$(g hash-object --path "$1" -- "$p")"
      ;;
    *) return 0 ;;
  esac
  [ "$current" != "$sha" ]
}

# Success when a parent directory of PATH is a symlink or not a directory,
# unless REF deletes that parent (it is then checked as its own entry).
parent_replaced() {
  local dir="$1" p
  while [[ "$dir" == */* ]]; do
    dir="${dir%/*}"
    p="$PROJECT/$dir"
    if [ -L "$p" ] || { [ -e "$p" ] && [ ! -d "$p" ]; }; then
      in_set "$REF_DELETES" "$dir" || return 0
    fi
  done
  return 1
}

# A path set is a string of newline-terminated entries, each path with "\"
# and newline escaped; an empty set is a single newline. (bash 3.2, the
# macOS default, has no associative arrays.)
# set_add NAME PATH adds PATH to the set in variable NAME.
set_add() {
  local k="${2//\\/\\\\}"
  k="${k//$'\n'/\\n}"
  printf -v "$1" '%s%s\n' "${!1}" "$k"
}

# in_set SET PATH succeeds when PATH is in SET.
in_set() {
  local k="${2//\\/\\\\}"
  k="${k//$'\n'/\\n}"
  [[ "$1" == *$'\n'"$k"$'\n'* ]]
}

# Fills ADDS MODS DELS SKIPPED CONFLICTS and the E_* entry arrays (in diff
# order).
compute_changes() {
  ADDS=() MODS=() DELS=() SKIPPED=() CONFLICTS=()
  E_STATUS=() E_PATH=() E_OMODE=() E_NMODE=() E_NSHA=()
  REF_DELETES=$'\n'
  local raw adds_in ignored_out
  raw="$(mktemp "$GITDIR/pl-diff.XXXXXX")"
  adds_in="$(mktemp "$GITDIR/pl-adds.XXXXXX")"
  ignored_out="$(mktemp "$GITDIR/pl-ignored.XXXXXX")"
  trap 'rm -f -- "$raw" "$adds_in" "$ignored_out"' EXIT
  g diff-tree -r -z --raw --no-abbrev --no-renames "$BASELINE" "$TARGET" >"$raw"

  local meta path omode nmode osha nsha status
  local -a r_meta=() r_path=()
  while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
    check_path "$path"
    r_meta+=("$meta")
    r_path+=("$path")
  done <"$raw"

  local i
  for i in "${!r_meta[@]}"; do
    [ "${r_meta[$i]##* }" != D ] || set_add REF_DELETES "${r_path[$i]}"
  done

  # Paths under a replaced parent are conflicts and are never read or
  # written through it. New paths matched by the exclude rules are skipped.
  local beyond=$'\n' ignored=$'\n'
  : >"$adds_in"
  for i in "${!r_meta[@]}"; do
    path="${r_path[$i]}"
    if parent_replaced "$path"; then
      set_add beyond "$path"
    elif [ "${r_meta[$i]##* }" = A ]; then
      printf '%s\0' "$path" >>"$adds_in"
    fi
  done
  local rc=0
  g check-ignore --no-index -z --stdin <"$adds_in" >"$ignored_out" || rc=$?
  [ "$rc" -le 1 ] || refuse "git check-ignore failed"
  while IFS= read -r -d '' path; do
    set_add ignored "$path"
  done <"$ignored_out"

  for i in "${!r_meta[@]}"; do
    read -r omode nmode osha nsha status <<<"${r_meta[$i]#:}"
    path="${r_path[$i]}"
    [ "$omode" != 160000 ] && [ "$nmode" != 160000 ] ||
      refuse "submodule entries are not supported: $path"
    case "$status" in
      A)
        if in_set "$ignored" "$path"; then
          SKIPPED+=("$path")
          continue
        fi
        ;;
      D | M | T) ;;
      *) refuse "unexpected change '$status' for $path" ;;
    esac
    E_STATUS+=("$status") E_PATH+=("$path") E_OMODE+=("$omode") E_NMODE+=("$nmode") E_NSHA+=("$nsha")
    case "$status" in
      A) ADDS+=("$path") ;;
      D) DELS+=("$path") ;;
      *) MODS+=("$path") ;;
    esac
    if in_set "$beyond" "$path"; then
      CONFLICTS+=("$path")
    elif [ "$status" = A ]; then
      if [ -e "$PROJECT/$path" ] || [ -L "$PROJECT/$path" ]; then
        CONFLICTS+=("$path")
      fi
    elif differs_from_baseline "$path" "$omode" "$osha"; then
      CONFLICTS+=("$path")
    fi
  done
  rm -f -- "$raw" "$adds_in" "$ignored_out"
  trap - EXIT
}

json_string() {
  local s="$1" i ch
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  if [[ "$s" == *[[:cntrl:]]* ]]; then
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\r'/\\r}"
    for i in {1..31}; do
      printf -v ch "\\$(printf '%03o' "$i")"
      s="${s//"$ch"/$(printf '\\u%04x' "$i")}"
    done
  fi
  printf '"%s"' "$s"
}

json_array() {
  local sep="" item
  printf '['
  for item in "$@"; do
    printf '%s' "$sep"
    json_string "$item"
    sep=","
  done
  printf ']'
}

print_changes() {
  printf '{"conflicts":'
  json_array ${CONFLICTS[@]+"${CONFLICTS[@]}"}
  printf ',"add":'
  json_array ${ADDS[@]+"${ADDS[@]}"}
  printf ',"modify":'
  json_array ${MODS[@]+"${MODS[@]}"}
  printf ',"delete":'
  json_array ${DELS[@]+"${DELS[@]}"}
  printf ',"skipped":'
  json_array ${SKIPPED[@]+"${SKIPPED[@]}"}
  printf '}\n'
}

cmd_preview() {
  [ "$#" -eq 3 ] || usage
  load_shadow "$@"
  compute_changes
  print_changes
}

# Write REF's blob SHA with MODE at PATH; OLD_MODE is the baseline mode or
# 000000 for a new path. Returns non-zero at the first failed step (callers
# run it as a condition, where set -e does not apply).
put_file() {
  local p="$PROJECT/$1" mode="$2" sha="$3" old_mode="$4" target
  mkdir -p -- "$(dirname -- "$p")" || return 1
  if [ "$mode" = 120000 ]; then
    target="$(g cat-file blob "$sha")" || return 1
    rm -f -- "$p" || return 1
    ln -s -- "$target" "$p" || return 1
    return 0
  fi
  if [ -L "$p" ]; then
    rm -f -- "$p" || return 1
  fi
  # Rewriting in place keeps the owner and permissions of an existing file.
  g cat-file blob "$sha" >"$p" || return 1
  if [ "$mode" = 100755 ] && [ "$old_mode" != 100755 ]; then
    chmod +x "$p" || return 1
  elif [ "$mode" = 100644 ] && [ "$old_mode" = 100755 ]; then
    chmod -x "$p" || return 1
  fi
}

# The project-relative parent of PATH ("" for the project root).
parent_of() {
  if [[ "$1" == */* ]]; then
    printf '%s' "${1%/*}"
  fi
}

# Success when entries can be created and removed in the nearest directory
# at or above DIR (project-relative) that exists and that REF does not delete.
dir_writable() {
  local dir="$1" p
  while [ -n "$dir" ]; do
    p="$PROJECT/$dir"
    if [ -d "$p" ] && ! in_set "$REF_DELETES" "$dir"; then
      [ -w "$p" ] && [ -x "$p" ]
      return
    fi
    dir="$(parent_of "$dir")"
  done
  [ -w "$PROJECT" ] && [ -x "$PROJECT" ]
}

# Fills UNWRITABLE with every entry writeback could not apply: a delete
# needs its directory writable; a regular file rewritten in place needs the
# file writable (and ownership for a mode change); anything created or
# replaced (new paths, symlinks) needs its directory writable.
check_writable() {
  UNWRITABLE=()
  local i path p is_root=0
  [ "$(id -u)" != 0 ] || is_root=1
  for i in "${!E_STATUS[@]}"; do
    path="${E_PATH[$i]}"
    p="$PROJECT/$path"
    if [ "${E_STATUS[$i]}" = D ] || [ "${E_NMODE[$i]}" = 120000 ] || [ -L "$p" ] || [ ! -e "$p" ]; then
      dir_writable "$(parent_of "$path")" || UNWRITABLE+=("$path")
    elif [ ! -w "$p" ]; then
      UNWRITABLE+=("$path")
    elif [ "${E_NMODE[$i]}" != "${E_OMODE[$i]}" ] && [ "$is_root" -eq 0 ] && [ ! -O "$p" ]; then
      UNWRITABLE+=("$path")
    fi
  done
}

# Stop after a failed write, naming what the project already holds.
write_failed() {
  {
    echo "shadow: writeback failed at $1 (it may be partly written); the project is partly written."
    if [ "${#WRITTEN[@]}" -gt 0 ]; then
      echo "These paths were already written (deleted or updated to the run's version):"
      printf '  %s\n' "${WRITTEN[@]}"
      echo "A rerun lists them as conflicts; check them by hand."
    else
      echo "No path was written before it."
    fi
  } >&2
  exit 3
}

cmd_writeback() {
  [ "$#" -eq 3 ] || usage
  load_shadow "$@"
  compute_changes
  if [ "${#CONFLICTS[@]}" -gt 0 ]; then
    {
      echo "shadow: writeback refused; nothing was written."
      echo "These project files changed during the run and the run changed them too:"
      printf '  %s\n' "${CONFLICTS[@]}"
    } >&2
    exit 3
  fi
  check_writable
  if [ "${#UNWRITABLE[@]}" -gt 0 ]; then
    {
      echo "shadow: writeback refused; nothing was written."
      echo "These paths cannot be written (the file or its directory is not writable):"
      printf '  %s\n' "${UNWRITABLE[@]}"
    } >&2
    exit 3
  fi

  local i dir
  WRITTEN=()
  for i in "${!E_STATUS[@]}"; do
    [ "${E_STATUS[$i]}" = D ] || continue
    rm -f -- "$PROJECT/${E_PATH[$i]}" || write_failed "${E_PATH[$i]}"
    WRITTEN+=("${E_PATH[$i]}")
    dir="${E_PATH[$i]}"
    while [[ "$dir" == */* ]]; do
      dir="${dir%/*}"
      rmdir -- "$PROJECT/$dir" 2>/dev/null || break
    done
  done
  for i in "${!E_STATUS[@]}"; do
    [ "${E_STATUS[$i]}" != D ] || continue
    put_file "${E_PATH[$i]}" "${E_NMODE[$i]}" "${E_NSHA[$i]}" "${E_OMODE[$i]}" ||
      write_failed "${E_PATH[$i]}"
    WRITTEN+=("${E_PATH[$i]}")
  done
  print_changes
}

# --- remove -----------------------------------------------------------------

cmd_remove() {
  [ "$#" -eq 1 ] || usage
  local target="$1" base_abs target_abs
  [ -d "$target" ] && [ ! -L "$target" ] || refuse "not a shadow directory: $target"
  base_abs="$(cd -- "$BASE" 2>/dev/null && pwd -P)" || refuse "shadow base $(native "$BASE") does not exist"
  target_abs="$(cd -- "$target" && pwd -P)"
  [ "$(dirname -- "$target_abs")" = "$base_abs" ] ||
    refuse "refusing to remove $(native "$target_abs"): not directly under $(native "$base_abs")"
  [[ "$(basename -- "$target_abs")" =~ ^[0-9a-f]{16}$ ]] && [ -f "$target_abs/pl-baseline" ] ||
    refuse "refusing to remove $(native "$target_abs"): not a shadow git dir"
  rm -rf -- "$target_abs"
}

[ "$#" -ge 1 ] || usage
command="$1"
shift
case "$command" in
  init) cmd_init "$@" ;;
  preview) cmd_preview "$@" ;;
  writeback) cmd_writeback "$@" ;;
  remove) cmd_remove "$@" ;;
  *) usage ;;
esac
