#!/usr/bin/env python3
"""Run a task's checks before it commits: targeted, the lane's, or widened.

usage: task-checks DIR --base SHA --ledger LEDGER_DIR --unit UNIT_ID --lane LANE
                   --task ID [--task ID ...]
                   [--declared PATH ... | --declared-from-owners N:HHHHHHHH]
                   [--widen PATH ...] [--permit PATH=PF-N ...] [--project-test CMD ...]
                   [--entry TASK_ID --targeted GROUP CMD [--targeted GROUP CMD ...]]
                   --lane-cmd GROUP CMD [...] (--wide-cmd GROUP CMD [...] | --wide-as-lane)
                   [--force-full REASON] [--evidence PATH] [--phase NAME]

Options come in any order. The workflow builds the call (spec 4.2 of the
1.6.0 check policy); the task's implementer runs it once before committing.
--phase NAME goes to run-checks, which sets PL_PHASE=NAME for the checks
(without it PL_PHASE is removed); NAME is one of run-checks' phases.

--declared-from-owners N:HHHHHHHH (1.6.6) stands for the unit's --declared
list, which keeps the engine-built call short: the list is read from
LEDGER_DIR/owners.json, each --task's `declared` in the order given, the
first occurrence of each exact string kept (_owners.owners_declared), and
checked against the fingerprint the engine computed from its own list (N the
number of paths, H their 32-bit FNV-1a hash, as _owners.fingerprint). A
value that is not a fingerprint (N of 0 included), or one given with
--declared, is a usage error. When owners.json is missing or unreadable, a
--task is not in it, a task has no `declared`, a path in it is absolute or
leaves the project, or the fingerprint differs, the call selects and runs
nothing and exits 3 with the error "the run's owner map (owners.json) does
not match this unit's Files list (<reason>): report blocked with this
message; do not run setup and do not pass --declared yourself (the session
reruns setup)", written as the error record when FILE is known (with
--evidence; without it nothing is written).

--wide-as-lane (1.6.6) stands for --wide-cmd pairs equal to the --lane-cmd
pairs: the lane list is used as the wide list. It cannot be given with
--wide-cmd; one of the two is required.

Selection (policy.selected):
  lane      no --entry: the unit has no task_checks entry, so the --lane-cmd
            list runs (the lane's checks, as before 1.6.0);
  widened   an entry, but a widening reason holds: the --wide-cmd list runs
            (the project's checks plus the lane's own additions);
  targeted  an entry and no widening reason: the --targeted list runs.
policy.reasons lists every reason that applies, as {code, detail}, in this
order: no_entry, no_files (no --declared and no --declared-from-owners),
outside_files (a changed path the
Files list does not cover, nor a ruling permits), widen_path (a changed path a --widen entry
covers), forced (--force-full, its REASON as detail), git_failed (the changed
paths could not be listed).

Changed paths: git diff --name-only --no-renames -z BASE (the working tree,
staged and unstaged, against BASE; a rename counts both paths) plus git
ls-files --others --exclude-standard -z (untracked files that are not
ignored), NUL-delimited, unique and sorted. Changes to ignored files are not
seen: widening for them is the agent's --force-full.

Coverage: '\\' becomes '/'; an entry ending in '/' is a directory and covers
every path under it; any other entry covers the equal path, except a --widen
entry that names an existing directory in DIR, which covers it as if it ended
in '/' (widening is the safe side; --declared keeps the strict rule). Paths are
normalized (posixpath.normpath) and compared case-sensitively, so on a
case-insensitive filesystem a case mismatch only widens. A --declared or
--widen value that is absolute or leaves the project after normalizing is a
usage error.

Permitted paths: a changed path outside the Files list counts as declared
and is listed in policy.permitted as {path, ruling} when it is permitted
this unit by, in this order:
  - a --permit PATH=PF-N (1.6.8, repeatable): this launch's pre-flight ruling
    PF-N (N from 1, no leading zero) permits PATH, a file, to one of the
    unit's tasks; the engine passes one per kept file. PATH goes through the
    --declared rules ('\\' becomes '/', normalized); a directory (ending in
    '/', or the project root), an absolute path, one that leaves the project,
    or a value without '=PF-N' is a usage error. ruling is 'PF-N';
  - an adjudicator ruling in force (its 'files', file paths only: an entry
    naming a directory permits nothing; filed under one of the --task ids,
    or under _run for a path that neither it nor a folder above it is named
    by a task's Files list in LEDGER_DIR/owners.json, in the folder of a
    --declared file or in a declared directory itself, folders compared by
    case), found by the ledger script's adjudicator_permits;
  - an earlier launch's pre-flight ruling in force whose 'permits' (written
    by ledger carry-launch) names the file for one of the --task ids, found
    by the ledger script's preflight_permits.
ruling is the ledger's ruling id for the last two. Implementer and reviewer
rulings permit nothing; a pre-flight ruling permits what its `permits` names
for its task. When the ledger cannot be read only --permit paths are
permitted; when the owner map cannot be read, none of _run's adjudicator
rulings are.

The chosen list runs through run-checks (DIR --out FILE --root LEDGER_DIR
--lock-held). FILE, the result file, is:
  - with --evidence PATH: PATH, reserved beforehand by await-checks reserve
    --ledger LEDGER_DIR --name task-<UNIT_ID>. Argv is read in full, then
    PATH is checked before any other usage check: --ledger and a safe
    --unit must be given, and PATH (any form on Windows, used in the C:/...
    form) must lie directly in LEDGER_DIR/checks, resolve inside
    LEDGER_DIR, be an existing regular file (not a symlink) of size 0, and
    be named task-<UNIT_ID>.<n>.json (n from 1, no leading zero).
    Otherwise exit 2 with nothing written.
  - without it: LEDGER_DIR/checks/task-<UNIT_ID>.<n>.json, n the first
    number from 1 whose file can be created exclusively; it must resolve
    inside LEDGER_DIR (1.6.0's reservation, for a manual call).
This helper holds FILE's check-file lock (_await.hold: an OS lock on the
sidecar FILE.lock) from the moment FILE is known until its last write, so
run-checks, told --lock-held, takes none, and a waiter (await-checks wait)
never takes run-checks' report, written before policy is added, for the
result. run-checks writes its JSON to FILE and its logs beside it; this
helper adds policy:
  {unit, tasks, lane, base, started, entry, selected, reasons, changed,
   permitted, offered: {targeted, lane, wide}, project_test_executed}
started is the UTC time this helper began (ISO 8601, milliseconds, Z);
project_test_executed is true when an executed command equals a
--project-test value. The file is rewritten in one step
(_shell.write_text_atomic) and printed as one JSON line. The printed copy
lists at most 50 of policy.changed and cuts each reason's detail at 2000
characters; when it cut anything it adds printed_cut, a note naming FILE,
which keeps everything. When run-checks
prints no JSON (a crash, or its exit 3), the file holds {"results": [],
"ok": false, "error": <its stderr tail>, "policy": ...}, printed too.

Error records: once FILE is known (a valid --evidence PATH, or the reserved
file), every later failure writes {"results": [], "ok": false, "error":
<message>, "policy": <the policy, or null when not yet built>} to FILE before
the exit: a usage error after a valid --evidence (exit 2), the lock not
taken within 5 s, an owner-map mismatch, or an unexpected error (exit 3). A
background run's output
is invisible to the agent that started it; the record says why it ended.

This evidence covers a working tree before a commit. Nothing reads it to
accept, skip or reuse checks: it is a record and a count.

UNIT_ID, LANE and every --task and --entry id must match
^[A-Za-z0-9_][A-Za-z0-9._-]*$.

BASE must be a commit sha (7 to 40 lowercase hex digits).

Exit: run-checks' exit when it printed JSON and exited 0 or 1 (0 every check
passed, 1 a check failed); 2 on a usage error (nothing is written, except
the error record after a valid --evidence); 3 when the reserved path is
outside LEDGER_DIR, FILE's lock cannot be taken, the owner map does not
match --declared-from-owners, run-checks printed no JSON
or exited with another code, or any unexpected error happened (with the
error record once FILE is known). Exit 1 always means a check failed.
"""

import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
import posixpath
import re
import stat
import subprocess
import sys
from datetime import datetime, timezone

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import _await  # noqa: E402
import _owners  # noqa: E402
import _shell  # noqa: E402

GIT_REDIRECTS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
                 "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR")
ENV = {k: v for k, v in os.environ.items() if k not in GIT_REDIRECTS}
SAFE_ID = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$")
SHA = re.compile(r"^[0-9a-f]{7,40}$")
ERROR_TAIL = 2000
PRINT_PATHS = 50
PRINT_DETAIL = 2000
USAGE = ("usage: task-checks DIR --base SHA --ledger LEDGER_DIR --unit UNIT_ID --lane LANE "
         "--task ID [...] [--declared PATH ... | --declared-from-owners N:HHHHHHHH] "
         "[--widen PATH ...] [--permit PATH=PF-N ...] [--project-test CMD ...] "
         "[--entry TASK_ID --targeted GROUP CMD ...] --lane-cmd GROUP CMD [...] "
         "(--wide-cmd GROUP CMD [...] | --wide-as-lane) [--force-full REASON] [--evidence PATH] "
         "[--phase NAME]")
# run-checks' phases (--phase sets PL_PHASE for the checks).
PHASES = ("prelude", "lane", "join", "integrate", "post-integrate", "final-fix", "verify")
SINGLE = {"--base": "base", "--ledger": "ledger", "--unit": "unit", "--lane": "lane",
          "--entry": "entry", "--force-full": "forced", "--evidence": "evidence", "--phase": "phase",
          "--declared-from-owners": "owners_fp"}
REPEATED = {"--task": "tasks", "--declared": "declared", "--widen": "widen",
            "--permit": "permit", "--project-test": "project_tests"}
# A --permit's ruling: this launch's pre-flight ruling, numbered from 1.
PF_ID = re.compile(r"PF-[1-9][0-9]*")
PAIRS = {"--targeted": "targeted", "--lane-cmd": "lane_cmds", "--wide-cmd": "wide_cmds"}
# Options that take no value.
FLAGS = {"--wide-as-lane": "wide_as_lane"}


# The result file once it is known (validated --evidence, or the reserved
# file) and the policy once it is built: fail writes its error record there.
_state = {"out": None, "policy": None}


def fail(code, message):
    """Exit with code; once the result file is known, write the error record
    there first."""
    if _state["out"] is not None:
        try:
            save(_state["out"], {"results": [], "ok": False, "error": message[-ERROR_TAIL:],
                                 "policy": _state["policy"]})
        except Exception:  # noqa: BLE001 - the exit code matters more than the record
            pass
    print(f"task-checks: {message}", file=sys.stderr)
    sys.exit(code)


def utc_stamp():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def entry_key(path):
    """(normalized path, is_directory) for a --declared or --widen value, or
    None when it is absolute or leaves the project."""
    p = path.replace("\\", "/")
    is_dir = p.endswith("/")
    if p.startswith("/") or re.match(r"^[A-Za-z]:", p):
        return None
    norm = posixpath.normpath(p)
    if norm == ".." or norm.startswith("../"):
        return None
    return norm, is_dir


def parse(argv):
    """Every option argv holds, read without exiting: args["usage"] is the
    first usage error the reading met (checked by validate), or None. A token
    that is not an option is skipped."""
    args = {"dir": None, "base": None, "ledger": None, "unit": None, "lane": None, "entry": None,
            "forced": None, "evidence": None, "phase": None, "owners_fp": None, "wide_as_lane": False,
            "tasks": [], "declared": [], "widen": [], "permit": [], "project_tests": [],
            "targeted": [], "lane_cmds": [], "wide_cmds": []}
    errors = []
    rest = argv
    if argv and argv[0] and not argv[0].startswith("-"):
        args["dir"], rest = argv[0], argv[1:]
    else:
        errors.append(USAGE)
        if argv and not argv[0]:
            rest = argv[1:]
    while rest:
        flag = rest[0]
        if flag in SINGLE and len(rest) >= 2 and rest[1]:
            if args[SINGLE[flag]] is not None:
                errors.append(f"{flag} given twice")
            else:
                args[SINGLE[flag]] = rest[1]
            rest = rest[2:]
        elif flag in REPEATED and len(rest) >= 2 and rest[1]:
            args[REPEATED[flag]].append(rest[1])
            rest = rest[2:]
        elif flag in PAIRS and len(rest) >= 3 and rest[1] and rest[2]:
            args[PAIRS[flag]].append((rest[1], rest[2]))
            rest = rest[3:]
        elif flag in FLAGS:
            if args[FLAGS[flag]]:
                errors.append(f"{flag} given twice")
            args[FLAGS[flag]] = True
            rest = rest[1:]
        else:
            errors.append(USAGE)
            rest = rest[1:]
    args["usage"] = errors[0] if errors else None
    return args


def check_evidence(args):
    """The --evidence path, native-pathed, once it passes the docstring's
    rules; else exit 2 with nothing written."""
    ledger, unit = args["ledger"], args["unit"]
    if ledger is None or unit is None or not SAFE_ID.fullmatch(unit):
        fail(2, "--evidence needs --ledger and a safe --unit")
    ledger = _shell.native_path(ledger)
    path = _shell.native_path(args["evidence"])
    if not re.fullmatch(r"task-" + re.escape(unit) + r"\.[1-9][0-9]*\.json", os.path.basename(path)):
        fail(2, f"--evidence {path!r} is not named task-{unit}.<n>.json")
    checks = os.path.realpath(os.path.join(ledger, "checks"))
    parent = os.path.realpath(os.path.dirname(os.path.abspath(path)))
    if os.path.normcase(parent) != os.path.normcase(checks) or not _shell.contained(path, ledger):
        fail(2, f"--evidence {path!r} is not in {os.path.join(ledger, 'checks')!r}")
    try:
        st = os.lstat(path)
    except OSError:
        fail(2, f"--evidence {path!r} does not exist")
    if not stat.S_ISREG(st.st_mode) or st.st_size != 0:
        fail(2, f"--evidence {path!r} is not an empty regular file")
    return path


def validate(args):
    """Every usage check but --evidence's: exit 2 on the first that fails."""
    if args["usage"] is not None:
        fail(2, args["usage"])
    for key in ("base", "ledger", "unit", "lane"):
        if args[key] is None:
            fail(2, f"--{key} is required")
    if not args["tasks"]:
        fail(2, "at least one --task is required")
    if args["phase"] is not None and args["phase"] not in PHASES:
        fail(2, f"--phase {args['phase']!r} is not one of {', '.join(PHASES)}")
    if not args["lane_cmds"] or not (args["wide_cmds"] or args["wide_as_lane"]):
        fail(2, "--lane-cmd and --wide-cmd (or --wide-as-lane) are required")
    if args["wide_as_lane"] and args["wide_cmds"]:
        fail(2, "--wide-as-lane and --wide-cmd do not go together")
    if args["owners_fp"] is not None:
        if not _owners.FINGERPRINT.fullmatch(args["owners_fp"]):
            fail(2, f"--declared-from-owners {args['owners_fp']!r} is not a fingerprint N:HHHHHHHH")
        if args["declared"]:
            fail(2, "--declared-from-owners and --declared do not go together")
    if (args["entry"] is None) != (not args["targeted"]):
        fail(2, "--entry and --targeted come together")
    if not SHA.match(args["base"]):
        fail(2, f"--base {args['base']!r} is not a commit sha")
    for value in [args["unit"], args["lane"], *args["tasks"]] + ([args["entry"]] if args["entry"] else []):
        if not SAFE_ID.match(value):
            fail(2, f"unsafe id {value!r}")
    args["declared_raw"] = list(args["declared"])
    for flag, key in (("--declared", "declared"), ("--widen", "widen")):
        keys = []
        for value in args[key]:
            k = entry_key(value)
            if k is None:
                fail(2, f"{flag} {value!r} is not a project-relative path")
            keys.append(k)
        args[key] = keys
    permits = []
    for value in args["permit"]:
        path, eq, ruling = value.rpartition("=")
        if not eq or not PF_ID.fullmatch(ruling):
            fail(2, f"--permit {value!r} is not PATH=PF-N")
        k = entry_key(path)
        # A permit names a file: a directory would cover every path under it.
        if k is None or k[1] or k[0] == ".":
            fail(2, f"--permit {value!r} does not name a project-relative file")
        permits.append((k, ruling))
    args["permit"] = permits
    args["dir"] = _shell.native_path(args["dir"])
    args["ledger"] = _shell.native_path(args["ledger"])
    # A --widen entry naming an existing directory covers it without the '/':
    # widening is the safe side. --declared keeps the strict rule.
    args["widen"] = [(e, d or os.path.isdir(os.path.join(args["dir"], e))) for e, d in args["widen"]]
    if args["wide_as_lane"]:
        args["wide_cmds"] = list(args["lane_cmds"])


OWNERS_MISMATCH = ("the run's owner map (owners.json) does not match this unit's Files list ({}): "
                   "report blocked with this message; do not run setup and do not pass --declared "
                   "yourself (the session reruns setup)")


def resolve_declared(args):
    """With --declared-from-owners: the unit's declared list from
    LEDGER_DIR/owners.json, checked against the fingerprint, as declared_raw
    and declared; exit 3 with the mismatch error otherwise."""
    if args["owners_fp"] is None:
        return
    path = os.path.join(args["ledger"], "owners.json")
    try:
        declared = _owners.owners_declared(path, args["tasks"], args["owners_fp"])
    except ValueError as e:
        fail(3, OWNERS_MISMATCH.format(e))
    keys = []
    for value in declared:
        k = entry_key(value)
        if k is None:
            fail(3, OWNERS_MISMATCH.format(f"owners.json lists {value!r}, which is not a project-relative path"))
        keys.append(k)
    args["declared_raw"] = declared
    args["declared"] = keys


def git_paths(directory, *git_args):
    """NUL-delimited paths a git command prints, or None when it fails."""
    res = subprocess.run(["git", "-C", directory, *git_args], capture_output=True, env=ENV)
    if res.returncode != 0:
        return None
    text = res.stdout.decode("utf-8", errors="surrogateescape")
    return [p for p in text.split("\0") if p]


def changed_paths(directory, base):
    tracked = git_paths(directory, "diff", "--name-only", "--no-renames", "-z", base, "--")
    untracked = git_paths(directory, "ls-files", "--others", "--exclude-standard", "-z")
    if tracked is None or untracked is None:
        return None
    return sorted(set(tracked) | set(untracked))


def covered(path, entries):
    # git always prints '/' separators: a '\' in a changed path is part of a
    # file name (possible on POSIX), never a separator, so such a path is not
    # covered (widened when in doubt).
    if "\\" in path:
        return False
    norm = posixpath.normpath(path)
    for entry, is_dir in entries:
        if norm == entry or (is_dir and (entry == "." or norm.startswith(entry + "/"))):
            return True
    return False


def permits(args):
    """[((path, is_dir), ruling id)]: the --permit paths, then the paths the
    adjudicator rulings and the carried pre-flight permits in force permit
    this unit (ledger's adjudicator_permits and preflight_permits, one helper
    for both scripts, from one load of the ledger script); only the --permit
    paths when the ledger cannot be read, so the strict rule holds for the
    rest."""
    out = list(args["permit"])
    try:
        loader = importlib.machinery.SourceFileLoader("_pl_ledger", os.path.join(HERE, "ledger"))
        spec = importlib.util.spec_from_loader("_pl_ledger", loader)
        ledger = importlib.util.module_from_spec(spec)
        with contextlib.redirect_stderr(io.StringIO()):
            loader.exec_module(ledger)
            found = ledger.adjudicator_permits(args["ledger"], args["tasks"], args["declared_raw"])
            found += ledger.preflight_permits(args["ledger"], args["tasks"])
    except (Exception, SystemExit):  # noqa: BLE001 - any failure keeps the strict rule
        return out
    for path, ruling in found:
        key = entry_key(path) if isinstance(path, str) else None
        # A permit covers its own path only, never a directory's contents.
        if key is not None and not key[1] and key[0] != ".":
            out.append((key, ruling))
    return out


def select(args, changed):
    """(selected, reasons, permitted) per the docstring's rules."""
    reasons = []
    permitted = []
    if args["entry"] is None:
        reasons.append({"code": "no_entry", "detail": "no task_checks entry for this unit"})
    if not args["declared"]:
        reasons.append({"code": "no_files", "detail": "the unit has no Files list"})
    if changed is not None:
        if args["declared"]:
            outside = [p for p in changed if not covered(p, args["declared"])]
            allowed = permits(args) if outside else []
            for p in list(outside):
                ruling = next((rid for key, rid in allowed if covered(p, [key])), None)
                if ruling is not None:
                    permitted.append({"path": p, "ruling": ruling})
                    outside.remove(p)
            if outside:
                reasons.append({"code": "outside_files", "detail": "outside the Files list: " + ", ".join(outside)})
        shared = [p for p in changed if covered(p, args["widen"])]
        if shared:
            reasons.append({"code": "widen_path", "detail": "shared path: " + ", ".join(shared)})
    if args["forced"] is not None:
        reasons.append({"code": "forced", "detail": args["forced"]})
    if changed is None:
        reasons.append({"code": "git_failed", "detail": "could not list the changed files"})
    if args["entry"] is None:
        return "lane", reasons, permitted
    return ("widened" if reasons else "targeted"), reasons, permitted


def reserve(ledger, unit):
    """Create LEDGER/checks/task-<unit>.<n>.json exclusively; its path."""
    checks = os.path.join(ledger, "checks")
    n = 1
    while True:
        path = os.path.join(checks, f"task-{unit}.{n}.json")
        if not _shell.contained(path, ledger):
            fail(3, f"evidence path {path!r} is outside {ledger!r}")
        os.makedirs(checks, exist_ok=True)
        if not _shell.contained(path, ledger):
            fail(3, f"evidence path {path!r} is outside {ledger!r}")
        try:
            os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY))
            return _shell.native_path(path)
        except FileExistsError:
            n += 1


def printed(report, out):
    """report as printed: long path lists cut, the full report left in out."""
    policy = report.get("policy")
    if not isinstance(policy, dict):
        return report
    changed = policy.get("changed") or []
    long_details = [r for r in policy.get("reasons") or [] if len(r.get("detail") or "") > PRINT_DETAIL]
    if len(changed) <= PRINT_PATHS and not long_details:
        return report
    cut = dict(policy, changed=changed[:PRINT_PATHS],
               reasons=[dict(r, detail=r["detail"][:PRINT_DETAIL] + " ... (cut)") if r in long_details else r
                        for r in policy["reasons"]])
    note = (f"this printed copy lists {min(len(changed), PRINT_PATHS)} of {len(changed)} changed paths "
            f"and cuts long reasons; {out} holds the full report")
    return dict(report, policy=cut, printed_cut=note)


def save(path, data):
    """Write data to path as one JSON line, in one step."""
    _shell.write_text_atomic(path, json.dumps(data) + "\n")


def crash(e):
    """Exit 3 for an unexpected error, with its error record."""
    fail(3, f"{type(e).__name__}: {e}")


def main(argv):
    """run, with any unexpected error (git missing, cygpath missing, an
    unwritable ledger) ending in exit 3, never 1, which means a check failed:
    an error record is written to the result file once it is known."""
    _shell.setup_io()
    try:
        run(argv)
    except SystemExit:
        raise
    except Exception as e:  # noqa: BLE001 - every failure must exit 3
        crash(e)


def holding(out, work):
    """work() inside out's check-file lock; out is the result file from here
    on, so every failure leaves its error record there, written before the
    lock is released."""
    _state["out"] = out
    with contextlib.ExitStack() as stack:
        try:
            stack.enter_context(_await.hold(out))
        except OSError as e:
            fail(3, f"cannot lock {out!r}: {e}")
        try:
            work()
        except SystemExit:
            raise
        except Exception as e:  # noqa: BLE001 - every failure must exit 3
            crash(e)


def run(argv):
    started = utc_stamp()
    args = parse(argv)
    if args["evidence"] is not None:
        out = check_evidence(args)

        def work():
            validate(args)
            resolve_declared(args)
            chosen, policy = plan(args, started)
            run_checks(args, chosen, policy, out)
        holding(out, work)
    else:
        validate(args)
        resolve_declared(args)
        chosen, policy = plan(args, started)
        out = reserve(args["ledger"], args["unit"])
        holding(out, lambda: run_checks(args, chosen, policy, out))


def plan(args, started):
    """(the command list to run, the policy) for validated args."""
    changed = changed_paths(args["dir"], args["base"])
    selected, reasons, permitted = select(args, changed)
    chosen = {"targeted": args["targeted"], "lane": args["lane_cmds"], "widened": args["wide_cmds"]}[selected]
    as_list = lambda pairs: [{"group": g, "command": c} for g, c in pairs]  # noqa: E731
    policy = {
        "unit": args["unit"], "tasks": args["tasks"], "lane": args["lane"], "base": args["base"],
        "started": started, "entry": args["entry"], "selected": selected, "reasons": reasons,
        "changed": changed if changed is not None else [],
        "permitted": permitted,
        "offered": {"targeted": as_list(args["targeted"]) if args["entry"] is not None else None,
                    "lane": as_list(args["lane_cmds"]), "wide": as_list(args["wide_cmds"])},
        "project_test_executed": False,
    }
    _state["policy"] = policy
    return chosen, policy


def run_checks(args, chosen, policy, out):
    """Run the chosen list through run-checks into out (whose lock this
    process holds), add policy, save, print, and exit."""
    cmd = [sys.executable, os.path.join(HERE, "run-checks"), args["dir"], "--out", out, "--root", args["ledger"],
           "--lock-held"]
    if args["phase"] is not None:
        cmd += ["--phase", args["phase"]]
    for group, command in chosen:
        cmd += ["--cmd", group, command]
    res = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", env=ENV)
    try:
        report = json.loads(res.stdout)
        if not isinstance(report, dict):
            raise ValueError("not an object")
    except ValueError:
        report = {"results": [], "ok": False,
                  "error": (res.stderr.strip() or f"run-checks exited {res.returncode} with no JSON")[-ERROR_TAIL:]}
        report["policy"] = policy
        save(out, report)
        print(json.dumps(printed(report, out)))
        sys.exit(3)
    executed = {r.get("command") for r in report.get("results", []) if isinstance(r, dict)}
    policy["project_test_executed"] = any(c in executed for c in args["project_tests"])
    report["policy"] = policy
    save(out, report)
    print(json.dumps(printed(report, out)))
    sys.exit(res.returncode if res.returncode in (0, 1) else 3)


if __name__ == "__main__":
    main(sys.argv[1:])
