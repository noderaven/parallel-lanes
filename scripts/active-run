#!/usr/bin/env bash
# Active-run markers and launch locks: one JSON marker per launched
# parallel-lanes run, so a later session can see which runs stopped and offer
# to resume them, and one lock per run while a session is running it, so a
# second launch or resume cannot reset a run that is still working.
#
# usage:
#   active-run acquire RUN_ID MANIFEST [--takeover]
#   active-run release RUN_ID STATUS|--remove --owner TOKEN
#   active-run write RUN_ID MANIFEST [STATUS]
#   active-run remove RUN_ID [--takeover]
#   active-run list
#
# Markers live in $PL_ACTIVE_DIR (default
# ${CLAUDE_CONFIG_DIR:-~/.claude}/parallel-lanes/active) as <RUN_ID>.json
# {run_id, manifest, started, status}; the lock is <RUN_ID>.lock holding the
# owner token. The directory is created with mode 0700. setup also writes
# checkout locks there, checkout-<st_dev>-<st_ino>.lock holding
# {"run_id", "checkout"}, one per feature checkout a git-mode run uses.
#
# acquire creates the lock atomically (it fails if the file exists), writes
# the marker with status running, and prints the owner token, which setup
# requires (setup --owner TOKEN). A run that is already locked is refused
# (exit 4): another session may still be running it. --takeover replaces an
# existing lock; use it only when the user confirms the session that held it
# has ended.
# release requires the owner token acquire printed (--owner TOKEN). When the
# run's lock holds another token (a takeover replaced it), release refuses
# (exit 4) and changes nothing. Otherwise it either writes the marker with
# STATUS or, with --remove, deletes the marker, and then removes the run's
# checkout locks and its lock. A run whose lock is already gone still gets its
# status recorded.
# write creates or replaces a marker: STATUS defaults to running, and
# rewriting an existing marker keeps its started time and updates its status.
# remove deletes a marker (a missing one is fine); a locked run is refused
# (exit 4) unless --takeover, which deletes the lock too; the run's checkout
# locks are deleted before its lock. list prints a
# JSON array of the markers sorted by run id, each with "locked": true when its
# lock exists, skipping files that are not valid markers (a marker's run_id
# must be a safe run id equal to its file name); a missing directory lists
# as [].
#
# acquire, release and remove do their lock work under a per-run mutex, the
# directory <active dir>/.<RUN_ID>.mutex (mkdir is atomic), so a takeover
# cannot slip between release's token check and its unlock. A waiter retries
# for $PL_MUTEX_WAIT seconds (default 10), then fails (exit 3) naming the
# mutex: it is stale only if no active-run is running.
#
# Exit 0 on success; 2 on usage error; 3 on an unsafe run id, a marker
# directory that cannot be created or written, or a mutex that stays held; 4
# when acquire or remove finds the run locked, or release finds it locked by
# another owner.
set -euo pipefail

dir="${PL_ACTIVE_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/parallel-lanes/active}"

usage() {
  echo "usage: active-run acquire RUN_ID MANIFEST [--takeover] | release RUN_ID STATUS|--remove --owner TOKEN" \
    "| write RUN_ID MANIFEST [STATUS] | remove RUN_ID [--takeover] | list" >&2
  exit 2
}

fail() {
  echo "active-run: $2" >&2
  exit "$1"
}

check_id() {
  [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || fail 3 "unsafe run id '$1'"
}

ensure_dir() {
  (umask 077 && mkdir -p "$dir") 2>/dev/null || fail 3 "cannot create $dir"
  [ -d "$dir" ] || fail 3 "$dir is not a directory"
  chmod 700 "$dir" 2>/dev/null || fail 3 "cannot set mode 700 on $dir"
}

# A file's contents as a compact marker object, or nothing if it is not one:
# its run_id must be a safe run id equal to the file's base name.
read_marker() {
  local name
  name="$(basename "$1" .json)"
  jq -c --arg name "$name" 'select(type == "object" and (.run_id | type) == "string"
    and (.run_id | test("^[A-Za-z0-9_][A-Za-z0-9._-]*$")) and .run_id == $name
    and (.manifest | type) == "string" and (.started | type) == "string"
    and (.status | type) == "string")' "$1" 2>/dev/null || true
}

write_marker() {
  local run_id="$1" manifest="$2" status="$3" target started tmp
  target="$dir/$run_id.json"
  started=""
  if [ -f "$target" ]; then
    started="$(read_marker "$target" | jq -r '.started' 2>/dev/null || true)"
  fi
  [ -n "$started" ] || started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  tmp="$(umask 077 && mktemp "$dir/.$run_id.XXXXXX")" || fail 3 "cannot write in $dir"
  if ! jq -n --arg run_id "$run_id" --arg manifest "$manifest" \
    --arg started "$started" --arg status "$status" \
    '{run_id: $run_id, manifest: $manifest, started: $started, status: $status}' >"$tmp" ||
    ! mv -f "$tmp" "$target"; then
    rm -f "$tmp"
    fail 3 "cannot write $target"
  fi
}

# Deletes the checkout locks (written by setup) that name run $1. Locks of
# other runs and files that are not valid JSON are left alone.
drop_checkout_locks() {
  local f
  for f in "$dir"/checkout-*.lock; do
    [ -f "$f" ] || continue
    if jq -e --arg id "$1" 'type == "object" and .run_id == $id' "$f" >/dev/null 2>&1; then
      rm -f "$f" || fail 3 "cannot remove $f"
    fi
  done
}

# The per-run mutex: lock_mutex RUN_ID takes <dir>/.<RUN_ID>.mutex, waiting up
# to $PL_MUTEX_WAIT seconds; unlock_mutex gives it back, and runs on exit too,
# so a failure inside the locked section never leaves it behind.
mutex=""

unlock_mutex() {
  [ -z "$mutex" ] || rmdir "$mutex" 2>/dev/null || true
  mutex=""
}

lock_mutex() {
  local path="$dir/.$1.mutex" wait="${PL_MUTEX_WAIT:-10}" tries=0
  [[ "$wait" =~ ^[0-9]+$ ]] || fail 2 "PL_MUTEX_WAIT must be a whole number of seconds"
  trap unlock_mutex EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  until mkdir "$path" 2>/dev/null; do
    if [ "$tries" -ge $((10#$wait * 10)) ]; then
      [ -d "$path" ] || fail 3 "cannot create $path"
      fail 3 "$path is held; if no active-run is running, remove it"
    fi
    tries=$((tries + 1))
    sleep 0.1
  done
  mutex="$path"
}

[ "$#" -ge 1 ] || usage
command -v jq >/dev/null 2>&1 || fail 3 "jq is required"

case "$1" in
  acquire)
    [ "$#" -ge 3 ] && [ "$#" -le 4 ] || usage
    run_id="$2" manifest="$3" takeover="${4-}"
    [ -n "$manifest" ] || usage
    [ -z "$takeover" ] || [ "$takeover" = "--takeover" ] || usage
    check_id "$run_id"
    ensure_dir
    lock="$dir/$run_id.lock"
    token="$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"
    [ -n "$token" ] || fail 3 "cannot generate an owner token"
    lock_mutex "$run_id"
    if [ -n "$takeover" ]; then
      tmp="$(umask 077 && mktemp "$dir/.$run_id.lock.XXXXXX")" || fail 3 "cannot write in $dir"
      printf '%s\n' "$token" >"$tmp" && mv -f "$tmp" "$lock" || fail 3 "cannot write $lock"
    elif ! (umask 077 && set -o noclobber && printf '%s\n' "$token" >"$lock") 2>/dev/null; then
      [ -e "$lock" ] || fail 3 "cannot write $lock"
      status="$( (read_marker "$dir/$run_id.json" | jq -r '.status') 2>/dev/null || true)"
      fail 4 "run $run_id is locked by another launch (marker status: ${status:-unknown}); if that session has ended, acquire again with --takeover"
    fi
    write_marker "$run_id" "$manifest" running
    unlock_mutex
    printf '%s\n' "$token"
    ;;
  release)
    [ "$#" -eq 5 ] && [ "$4" = "--owner" ] || usage
    run_id="$2" what="$3" owner="$5"
    [ -n "$what" ] && [ -n "$owner" ] || usage
    check_id "$run_id"
    ensure_dir
    lock="$dir/$run_id.lock"
    lock_mutex "$run_id"
    if [ -e "$lock" ]; then
      held="$(head -n 1 "$lock" 2>/dev/null)" || fail 3 "cannot read $lock"
      [ "$held" = "$owner" ] ||
        fail 4 "run $run_id is locked by another owner (its lock was taken over); nothing was released"
    fi
    if [ "$what" = "--remove" ]; then
      rm -f "$dir/$run_id.json" || fail 3 "cannot remove $dir/$run_id.json"
    else
      manifest="$( (read_marker "$dir/$run_id.json" | jq -r '.manifest') 2>/dev/null || true)"
      [ -n "$manifest" ] || fail 3 "no marker for run $run_id to release"
      write_marker "$run_id" "$manifest" "$what"
    fi
    drop_checkout_locks "$run_id"
    rm -f "$lock" || fail 3 "cannot remove $lock"
    unlock_mutex
    ;;
  write)
    [ "$#" -ge 3 ] && [ "$#" -le 4 ] || usage
    run_id="$2" manifest="$3" status="${4-running}"
    [ -n "$manifest" ] && [ -n "$status" ] || usage
    check_id "$run_id"
    ensure_dir
    write_marker "$run_id" "$manifest" "$status"
    ;;
  remove)
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
    [ "$#" -eq 2 ] || [ "$3" = "--takeover" ] || usage
    check_id "$2"
    ensure_dir
    lock_mutex "$2"
    if [ -e "$dir/$2.lock" ] && [ "$#" -eq 2 ]; then
      fail 4 "run $2 is locked by a launch that may still be running; if that session has ended, remove it with --takeover"
    fi
    drop_checkout_locks "$2"
    rm -f "$dir/$2.json" "$dir/$2.lock" || fail 3 "cannot remove $dir/$2.json"
    unlock_mutex
    ;;
  list)
    [ "$#" -eq 1 ] || usage
    shopt -s nullglob
    for f in "$dir"/*.json; do
      m="$(read_marker "$f")"
      [ -n "$m" ] || continue
      if [ -e "${f%.json}.lock" ]; then
        printf '%s\n' "$m" | jq -c '. + {locked: true}'
      else
        printf '%s\n' "$m" | jq -c '. + {locked: false}'
      fi
    done | jq -s -c 'sort_by(.run_id)'
    ;;
  *)
    usage
    ;;
esac
