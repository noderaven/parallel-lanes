#!/usr/bin/env python3
"""Per-lane append-only event ledger.

usage:
  ledger append DIR LANE JSON
  ledger reviewed DIR LANE TASK ROUNDS PLAN CHECKOUT HEAD BLOCKING [SPEC]
  ledger status DIR [--plan PLAN] [--spec SPEC] [--manifest MANIFEST]
  ledger backfill DIR MANIFEST
  ledger accept DIR CHECKOUT HEAD TEXT
  ledger ended DIR STATUS AGENTS RULINGS
  ledger conditions DIR WF_ID DOCTOR_FILE
  ledger rulings DIR [--lane LANE]
  ledger carry-launch DIR TRANSCRIPT_DIR|WF_ID
  ledger minors DIR
  ledger write-owners DIR MANIFEST
  ledger owners DIR --task ID [--task ID ...] PATH ...
  ledger undeclared DIR

append writes JSON as one line to DIR/<LANE>.jsonl, creating DIR with mode
0700. JSON must be an object with a safe non-empty string 'task' (or "_run")
and an 'event' of:
  committed    with 'commits': non-empty list of strings; finish-task also
               writes 'base' and 'head' (non-empty strings, both or neither)
  reviewed     with 'rounds': integer >= 0; 'ledger reviewed' also writes
               'brief_sha256' (64 hex digits) and 'head', and with SPEC
               'spec_sha256' (64 hex digits or null)
  ruling       with 'text': string
  blocked      with 'reason': string
  run_started  with 'phase': "setup" or "join", and 'head': non-empty string;
               setup also writes 'plan_sha256' and 'spec_sha256' (hex or null)
  settled      with 'outcome': "park" or "unblock", and 'base' and 'head':
               non-empty strings; optional 'commits': list of strings
  reopened     with 'reason': string (an approval that no longer holds: the
               task counts as not reviewed again)
  started      with 'base': non-empty string (the task base, recorded by
               start-task --record-start before the implementer writes);
               a join wave unit (1.6.5) also has 'dir' (its worktree) and
               'unit_branch' (pl-<run_id>-u-<unit id>), and a unit begun
               again from the feature tip 'restart': true
  run_ended    with 'status': non-empty string, and 'agents' and 'rulings':
               integers >= 0 (what one launch spent)
  accepted     with 'text': non-empty string and 'head': non-empty string (the
               user explicitly accepted that revision despite named reasons or
               warnings; 'ledger accept' writes it)
  minors       task _run only, with 'wf' and 'open': a list of objects (the
               task minors still open after that launch: id, task, file, line,
               issue, fix) and 'covered': task ids; carry-launch writes it
  carried      task _run only, with 'wf', 'pf' ({"PF-n": ruling id}) and
               'bound' ([{file, line}]); carry-launch writes it last, once per
               launch
  wave_merged  task _run only, with 'units': non-empty list of unit ids,
               'head', and exactly one of 'wave' (integer >= 1) and
               'recovery': true; optional 'overlaps' ([{path, units}]) and
               'conflict_files' (paths); merge-wave writes it
  wave_checked task _run only, with 'wave' (integer >= 1), 'head' and 'ok'
               (true or false); 'unfinished': true when the checks stopped
               without a result (ok false)
Appends to a lane file hold the file's own OS lock (_oslock), waiting up to
5 s for another appender (LEDGER_LOCK_WAIT_S overrides it for tests), else
exit 3 with nothing written. A reader skips a last line that has no newline
yet and is not JSON: an append in progress.
A ruling may carry 'by' (implementer, reviewer, adjudicator, preflight; none:
a task agent before 1.6.3, read as an implementer), 'scope' (lane, run),
'overrides' and 'files' (lists of strings), 'pf' (PF-n) and 'wf'. The values
are checked, not whether an agent told the truth.

rulings prints the rulings in force, one per line: '<id> [<role>, <task>,
<scope>] <text>', then ' (overrides <ids>)' (an id that resolves to no ruling
marked '(unknown)') and ' (files <paths>)'; then 'Overridden:' and '<id> by
<id>' for each ruling another overrides; '(none)' when there is none. A
ruling's id is '<file stem>-R<n>', n counting that file's rulings in append
order. A PF-n in 'overrides' resolves through the carried event that bound
the ruling. With --lane LANE: the rulings of _run, prelude and LANE, and every
one whose scope is run (a ruling's scope defaults to run in _run, else lane).

carry-launch reads a launch's Workflow result file (from its transcript dir,
or for a wf id from <CLAUDE_CONFIG_DIR or ~/.claude>/projects/*/*/workflows/
<wf>.json) and appends, once per wf: each of result.preflight.rulings as a
ruling by preflight with scope run and pf PF-<n> (the adjudication at
preflight.adjudicated is skipped: the adjudicator recorded it; a result
without that field and with conflicts has it last); a minors event; and a
carried event binding every ruling whose overrides name a PF-n no earlier
carried event bound. Launches are carried in launch order: with the ledger's
doctor-<wf>.json files (ledger conditions) naming each launch's setup event,
carrying a launch while an earlier one is not carried exits 3 naming it, and
the adjudication is looked for between the launch's setup run_started and the
next one. The open minors: the previous snapshot's, less the
entries of tasks done in this launch and the carried ids this launch's final
review raised, plus each task done in this launch's minor_findings less the
ids the final review raised (none without one). Prints {"carried", "rulings",
"open_minors"}, or {"carried", "already": true}; exit 3 and nothing written
when no readable result is found or DIR does not exist. Its events go to
_run.jsonl in one write.

minors prints the latest snapshot: '[<id>] <task> <file>:<line> - <issue>
(fix: <fix>)' per minor, or '(none)'. write-owners writes DIR/owners.json
from MANIFEST (setup writes the same file itself); owners prints, for each
PATH, what it is seen from the given tasks (see start-task --owners);
undeclared prints status --manifest's undeclared from owners.json instead of
a manifest. Both exit 3 without a readable owners.json.

reviewed appends a reviewed event for TASK with ROUNDS, the sha256 of TASK's
own section in PLAN (what the review approved against; _brief.section_sha256)
and the full sha HEAD resolves to (the code it approved, the head of the range
under review). It refuses (exit 3, nothing recorded) when BLOCKING, the
number of critical and important findings the reviewer reports, is not 0 (an
approval with blocking findings is not an approval), when PLAN has no section
for TASK, or when HEAD is not a commit that CHECKOUT's HEAD contains. With
SPEC, the spec the review read (a path, or - for none), it also records
spec_sha256: the file's sha256, or null for -; a SPEC it cannot read is exit
3 and nothing is recorded. Without SPEC no spec_sha256 is recorded.

status reads every DIR/*.jsonl and prints
  {"done": [...], "reviewed": [...], "blocked": [...], "deferred": [...],
   "start_points": {...}, "carry": {...}, "ranges": {...}, "legacy": [...],
   "inconsistent": [...], "stale": [...], "unbound": [...], "inputs": {...},
   "spent": {"agents", "rulings"}, "accepted": [{head, text}],
   "undeclared": {...}}
done: tasks with a 'committed' or 'settled' event. reviewed: tasks with a
'reviewed' or 'settled' event after their last 'committed'. blocked: tasks
with a 'blocked' event and no 'committed' or 'settled' after it. deferred:
tasks whose last 'committed' or 'settled' event is a 'settled' (parked or
unblocked by the adjudicator: done and reviewed for scheduling, never
accepted). ranges: {task: {base, head}} from the base of the task's first
'committed' or 'settled' event and the head of its last, for tasks whose
events record a base. legacy: done tasks with a 'committed' event that records
no base (written before finish-task recorded ranges; ledger backfill derives
their base). inconsistent: [{task, reason}] when one event's base is not the
previous event's head, or when a task's first event does not start at the
base of the latest 'started' event before it (or a later 'started' event
names neither the task base nor its last head). start_points: "prelude" is the head of the earliest
run_started event with phase "setup", "join" the head of the earliest with
phase "join". carry: for each task whose last 'committed' or 'settled' event
is a 'settled' with outcome "unblock", the text of that task's last 'ruling'
event with "by": "adjudicator" after its last 'committed'.
With --plan PLAN, every reviewed task (not settled) is checked against PLAN:
stale lists [{task, reason}] when the review's brief_sha256 differs from the
task's current section, the task has no section, or the review's head is not
the task's recorded head, or the spec moved on: a review that recorded
spec_sha256 is stale when it differs from SPEC's sha256 (null without
--spec: no spec now) ("the spec changed since its review"), and one that
recorded none (from before 1.4.4) is stale whenever the run has a spec: SPEC
is given, or any setup run_started recorded a non-null spec_sha256 ("the
review recorded no spec (it predates 1.4.4) and this run has one"). unbound lists
reviewed tasks whose review recorded no brief_sha256. Both are left out of
reviewed, so a resume reviews them again. inputs: {"plan_changed", "spec_changed"}: true or false against the
hashes the latest setup run_started recorded (the last launch; with --plan /
--spec), null when nothing was recorded or no file was given.
spent: {"agents", "rulings", "unrecorded_launches"}: the sums of 'agents'
and 'rulings' over every run_ended event (the budget earlier launches used);
rulings is at least the number of 'ruling' events with "by": "adjudicator"
(they survive a session that died); unrecorded_launches is the number of
setup run_started events without a run_ended (their agents are not counted). accepted: every accepted event, in order.
With --manifest MANIFEST (and --plan), a reviewed task whose depends_on names a
stale task is stale too ("it depends on <id>, whose approval is stale"),
transitively, in run order. undeclared (with --manifest; else {}): {task:
[{path, owner, relation}]} for each task with a recorded range and a non-empty
files list whose range changes a path (git diff --name-only --no-renames base
head) that is not in its files, nor in the files of a task with the same range
(a batch); paths compare normalized and case-insensitively, non-ASCII ones
unquoted. owner is the first other task whose files list the path (null when
none does) and relation when that task runs: earlier, alongside or later.
minors: {"open": [ids], "covered": [task ids]} from the latest minors event
(empty lists without one). overrides: [{id, by, task, overrides, unknown,
targets}] for each ruling that names others it departs from (resolved; unknown
lists the ones that name no ruling; targets gives each known one's id, role
and lane, the ledger file it is in).
A missing DIR has empty lists, no start points, and no carry.

accept appends {"task": "_run", "event": "accepted", "head": <full sha>,
"text": TEXT} to DIR/_run.jsonl. It refuses (exit 3) when HEAD is not a commit
in CHECKOUT, and (exit 2) when TEXT is empty.

ended appends {"task": "_run", "event": "run_ended", "status": STATUS,
"agents": AGENTS, "rulings": RULINGS} to DIR/_run.jsonl: what one launch
spent, recorded in one command. AGENTS and RULINGS are decimal integers >= 0;
it refuses (exit 2, nothing recorded) a count that is not one, or an empty
STATUS.

conditions binds a saved doctor result (doctor --save) to the launch it was
observed for: it writes DIR/doctor-<WF_ID>.json (indent 2), never a ledger
event, so status, backfill and resume do not see it:
  {"launch": {"wf": WF_ID, "setup_event": N, "setup_head": sha},
   "recorded_at": "YYYY-MM-DDTHH:MM:SSZ", "doctor": <DOCTOR_FILE's object>}
N is the number of setup run_started events in DIR (the latest one is this
launch's) and setup_head is the head of the last of them. WF_ID must match
^wf_[a-z0-9-]{6,64}$ and DOCTOR_FILE must hold a JSON object (else exit 2).
When doctor-<WF_ID>.json exists with the same launch and doctor, it is a
no-op (exit 0, the file untouched). Otherwise it refuses (exit 3, nothing
written, {"refused": CODE} on stdout), checked in this order:
  wf_recorded         doctor-<WF_ID>.json exists and differs
  not_doctor          DOCTOR_FILE has no 'status', or no 'observed_at' of the
                      form YYYY-MM-DDTHH:MM:SSZ
  no_setup            DIR has no setup run_started event (a missing DIR
                      included; DIR is never created)
  setup_recorded      another doctor-*.json names the same setup_event
  observation_reused  another doctor-*.json has the same doctor.observed_at
Other doctor-*.json files that do not read as JSON objects are ignored. On
success it prints {"recorded": "doctor-<WF_ID>.json", "setup_event": N}.

backfill reads the manifest's task lists (prelude, lanes in order, join), its
repo, and start_points, and prints {"backfill": {task: {base, head}},
"derived": [...], "errors": [...]} for every done task. A task with a
recorded range uses it. A legacy task gets base = the head of the previous
done task in its list, or for the first task of a list its start point
(prelude and lanes: the last prelude head, else start_points.prelude; join:
start_points.join), and head = the last commit of its last event; it is listed
in derived. Every range is checked against git: base must be an ancestor of
head, and a committed event's commits must be exactly git rev-list base..head
of that event. Any failure is listed in errors and the exit is 3: a resume
must not narrow or guess a review range.

Exit 0 on success; 2 on usage error or a malformed entry; 3 on an unsafe lane
or task name, an unreadable ledger, plan or manifest, or a backfill error.
"""

import hashlib
import glob
import json
import os
import posixpath
import re
import subprocess
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _brief  # noqa: E402
import _oslock  # noqa: E402
import _owners  # noqa: E402
import _shell  # noqa: E402

LANE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
REQUIRED = {
    "committed": "commits",
    "reviewed": "rounds",
    "ruling": "text",
    "blocked": "reason",
    "run_started": "head",
    "settled": "outcome",
    "reopened": "reason",
    "started": "base",
    "run_ended": "status",
    "accepted": "text",
    "minors": "open",
    "carried": "wf",
    "wave_merged": "units",
    "wave_checked": "head",
}
RULING_ROLES = ("implementer", "reviewer", "adjudicator", "preflight")
RULING_SCOPES = ("lane", "run")
PF_ID = re.compile(r"^PF-[1-9][0-9]*$")
# Events only the _run file holds: one per launch, written by carry-launch.
RUN_ONLY = ("minors", "carried")
SETTLED_OUTCOMES = ("park", "unblock")
START_POINTS = {"setup": "prelude", "join": "join"}
# Join waves (1.6.5): the _run events of a wave's merge and checks, and the
# branch form of a join unit's own branch (pl-<run_id>-u-<unit id>).
WAVE_EVENTS = ("wave_merged", "wave_checked")
UNIT_BRANCH = re.compile(r"^pl-[a-z0-9-]+-u-[A-Za-z0-9_][A-Za-z0-9._-]*$")
# How long an append waits for another appender's lock on the same lane file.
LOCK_WAIT_S = 5.0
GIT_REDIRECTS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
                 "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR")
ENV = {k: v for k, v in os.environ.items() if k not in GIT_REDIRECTS}


def fail(code, message):
    print(f"ledger: {message}", file=sys.stderr)
    sys.exit(code)


def is_text(v):
    return isinstance(v, str) and v != ""


def entry_error(entry):
    """Return why entry is not a valid ledger event, or None."""
    if not isinstance(entry, dict):
        return "entry must be a JSON object"
    task = entry.get("task")
    if not is_text(task):
        return "'task' must be a non-empty string"
    if not LANE.fullmatch(task):
        return f"'task' {task!r} is not a safe task id"
    event = entry.get("event")
    if event not in REQUIRED:
        return f"'event' must be one of {', '.join(REQUIRED)}"
    key = REQUIRED[event]
    value = entry.get(key)
    if event == "committed":
        ok = isinstance(value, list) and value and all(is_text(c) for c in value)
        if not ok:
            return "'commits' must be a non-empty list of strings"
        has = [f in entry for f in ("base", "head")]
        if any(has) and not all(is_text(entry.get(f)) for f in ("base", "head")):
            return "'base' and 'head' must both be non-empty strings when either is present"
    elif event == "reviewed":
        if not isinstance(value, int) or isinstance(value, bool) or value < 0:
            return "'rounds' must be an integer >= 0"
        if "brief_sha256" in entry and not (isinstance(entry["brief_sha256"], str)
                                            and SHA256.fullmatch(entry["brief_sha256"])):
            return "'brief_sha256' must be 64 lowercase hex digits"
        if "head" in entry and not is_text(entry["head"]):
            return "'head' must be a non-empty string"
        v = entry.get("spec_sha256")
        if "spec_sha256" in entry and v is not None and not (isinstance(v, str) and SHA256.fullmatch(v)):
            return "'spec_sha256' must be 64 lowercase hex digits or null"
    elif event == "run_started":
        if entry.get("phase") not in START_POINTS:
            return "'phase' must be one of setup, join"
        if not is_text(value):
            return "'head' must be a non-empty string"
        for field in ("plan_sha256", "spec_sha256"):
            v = entry.get(field)
            if field in entry and v is not None and not (isinstance(v, str) and SHA256.fullmatch(v)):
                return f"'{field}' must be 64 lowercase hex digits or null"
    elif event == "settled":
        if value not in SETTLED_OUTCOMES:
            return "'outcome' must be one of park, unblock"
        for field in ("base", "head"):
            if not is_text(entry.get(field)):
                return f"'{field}' must be a non-empty string"
        if "commits" in entry and not (isinstance(entry["commits"], list)
                                       and all(is_text(c) for c in entry["commits"])):
            return "'commits' must be a list of strings"
    elif event in ("started", "run_ended"):
        if not is_text(value):
            return f"'{key}' must be a non-empty string"
        if event == "started":
            return started_fields_error(entry)
        if event == "run_ended":
            for field in ("agents", "rulings"):
                v = entry.get(field)
                if not isinstance(v, int) or isinstance(v, bool) or v < 0:
                    return f"'{field}' must be an integer >= 0"
    elif event == "accepted":
        if not is_text(value) or not is_text(entry.get("head")):
            return "'text' and 'head' must be non-empty strings"
    elif event == "ruling":
        if not isinstance(value, str):
            return "'text' must be a string"
        return ruling_fields_error(entry)
    elif event in RUN_ONLY:
        return run_only_error(entry)
    elif event in WAVE_EVENTS:
        return wave_error(entry)
    elif not isinstance(value, str):
        return f"'{key}' must be a string"
    return None


def is_text_list(v):
    return isinstance(v, list) and all(is_text(x) for x in v)


def ruling_fields_error(entry):
    """Why a ruling's optional 1.6.3 fields are malformed, or None. The values
    are checked; whether an agent told the truth about its role is not."""
    if "by" in entry and entry["by"] not in RULING_ROLES:
        return f"'by' must be one of {', '.join(RULING_ROLES)}"
    if "scope" in entry and entry["scope"] not in RULING_SCOPES:
        return f"'scope' must be one of {', '.join(RULING_SCOPES)}"
    for field in ("overrides", "files"):
        if field in entry and not is_text_list(entry[field]):
            return f"'{field}' must be a list of non-empty strings"
    if "pf" in entry and not (isinstance(entry["pf"], str) and PF_ID.fullmatch(entry["pf"])):
        return "'pf' must look like PF-1"
    if "wf" in entry and not is_text(entry["wf"]):
        return "'wf' must be a non-empty string"
    return None


def is_count(v, least):
    return isinstance(v, int) and not isinstance(v, bool) and v >= least


def started_fields_error(entry):
    """Why a started event's join wave fields (1.6.5) are malformed, or
    None: dir, the worktree a unit ran in; unit_branch, its own branch;
    restart (true), a unit begun again from the feature tip."""
    if "dir" in entry and not is_text(entry["dir"]):
        return "'dir' must be a non-empty string"
    if "unit_branch" in entry and not (isinstance(entry["unit_branch"], str)
                                       and UNIT_BRANCH.fullmatch(entry["unit_branch"])):
        return "'unit_branch' must be a branch of the form pl-<run_id>-u-<unit id>"
    if "restart" in entry and entry["restart"] is not True:
        return "'restart' must be true when present"
    return None


def wave_error(entry):
    """Why a wave_merged or wave_checked event is malformed, or None."""
    if entry["task"] != "_run":
        return f"a {entry['event']} event belongs to task _run"
    if not is_text(entry.get("head")):
        return "'head' must be a non-empty string"
    if entry["event"] == "wave_merged":
        if not (isinstance(entry.get("units"), list) and entry["units"] and is_text_list(entry["units"])):
            return "'units' must be a non-empty list of unit ids"
        has_wave, has_recovery = "wave" in entry, "recovery" in entry
        if has_wave == has_recovery:
            return "a wave_merged event has exactly one of 'wave' and 'recovery'"
        if has_wave and not is_count(entry["wave"], 1):
            return "'wave' must be an integer >= 1"
        if has_recovery and entry["recovery"] is not True:
            return "'recovery' must be true"
        overlaps = entry.get("overlaps", [])
        if not (isinstance(overlaps, list) and all(isinstance(o, dict) and is_text(o.get("path"))
                                                   and is_text_list(o.get("units")) for o in overlaps)):
            return "'overlaps' must be a list of {path, units}"
        if not is_text_list(entry.get("conflict_files", [])):
            return "'conflict_files' must be a list of paths"
    else:
        if not is_count(entry.get("wave"), 1):
            return "'wave' must be an integer >= 1"
        if not isinstance(entry.get("ok"), bool):
            return "'ok' must be true or false"
        if "unfinished" in entry and not (entry["unfinished"] is True and entry["ok"] is False):
            return "'unfinished' must be true, and only with ok false"
    return None


def run_only_error(entry):
    """Why a minors or carried event is malformed, or None."""
    if entry["task"] != "_run":
        return f"a {entry['event']} event belongs to task _run"
    if not is_text(entry.get("wf")):
        return "'wf' must be a non-empty string"
    if entry["event"] == "minors":
        if not isinstance(entry.get("open"), list) or not all(isinstance(m, dict) for m in entry["open"]):
            return "'open' must be a list of objects"
        if not is_text_list(entry.get("covered", [])):
            return "'covered' must be a list of task ids"
    else:
        if not isinstance(entry.get("pf", {}), dict):
            return "'pf' must be an object"
        if not isinstance(entry.get("bound", []), list):
            return "'bound' must be a list"
    return None


def write_entry(directory, lane, entry):
    append_entries(directory, lane, [entry])


def append_entries(directory, lane, entries):
    """Append entries to DIR/<lane>.jsonl in one write: every entry is
    validated first, so an invalid one writes none, and a reader never sees
    half of them (carry-launch's rulings, snapshot and marker)."""
    if not LANE.fullmatch(lane):
        fail(3, f"unsafe lane name {lane!r}")
    for entry in entries:
        error = entry_error(entry)
        if error:
            fail(2, error)
    # Parallel lanes may make their first append at the same moment, so the
    # directory may appear between any check and create. Only the process that
    # creates it sets the mode (makedirs honors umask); the rest just append.
    try:
        os.makedirs(directory, mode=0o700)
    except FileExistsError:
        if not os.path.isdir(directory):
            fail(3, f"ledger path {directory!r} exists and is not a directory")
    else:
        os.chmod(directory, 0o700)
    line = "".join(json.dumps(e, ensure_ascii=True, separators=(",", ":")) + "\n" for e in entries)
    path = os.path.join(directory, f"{lane}.jsonl")
    # Join wave units append to one lane file at once (1.6.5), and an
    # O_APPEND write is not atomic across processes on Windows: appends to a
    # lane file take the file's own OS lock (_oslock: on Windows one byte far
    # past the text, so readers and the append itself are not blocked),
    # waiting a while for another appender.
    fd = os.open(path, os.O_RDWR | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        wait = lock_wait_s()
        deadline = time.monotonic() + wait
        while not _oslock.try_lock(fd):
            if time.monotonic() >= deadline:
                fail(3, f"{lane}.jsonl stayed locked for {wait:g} s; nothing written")
            time.sleep(0.05)
        try:
            # O_APPEND writes at the end wherever the lock left the offset.
            os.write(fd, line.encode("ascii"))
        finally:
            _oslock.unlock(fd)
    finally:
        os.close(fd)


def lock_wait_s():
    """LOCK_WAIT_S, or LEDGER_LOCK_WAIT_S when set to a number >= 0 (tests)."""
    try:
        v = float(os.environ.get("LEDGER_LOCK_WAIT_S", LOCK_WAIT_S))
    except ValueError:
        return LOCK_WAIT_S
    return v if v >= 0 else LOCK_WAIT_S


def append(directory, lane, raw):
    try:
        entry = json.loads(raw)
    except json.JSONDecodeError as e:
        fail(2, f"invalid JSON: {e}")
    write_entry(directory, lane, entry)


def read_text(path, what):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError) as e:
        fail(3, f"cannot read {what} {path!r}: {e}")


def file_sha256(path):
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError as e:
        fail(3, f"cannot read {path!r}: {e}")


def reviewed(directory, lane, task, rounds, plan, checkout, head, blocking, spec=None):
    if not re.fullmatch(r"[0-9]+", rounds):
        fail(2, "ROUNDS must be an integer >= 0")
    if not re.fullmatch(r"[0-9]+", blocking):
        fail(2, "BLOCKING must be the number of critical and important findings")
    if int(blocking) != 0:
        fail(3, f"an approval with {blocking} critical or important finding(s) is not an approval; "
                "nothing recorded (return verdict changes)")
    try:
        digest = _brief.section_sha256(read_text(plan, "plan"), task)
    except _brief.BriefError as e:
        fail(3, str(e))
    entry = {"task": task, "event": "reviewed", "rounds": int(rounds), "brief_sha256": digest}
    if spec is not None:
        # What the review read as the spec: its hash, or null for none ("-").
        entry["spec_sha256"] = None if spec == "-" else file_sha256(spec)

    def git(*args):
        return subprocess.run(["git", "-C", checkout, *args], capture_output=True, text=True, encoding="utf-8",
                              errors="surrogateescape", env=ENV)

    res = git("rev-parse", "--verify", "--quiet", "--end-of-options", f"{head}^{{commit}}")
    if res.returncode != 0 or not res.stdout.strip():
        fail(3, f"{head!r} is not a commit in {checkout!r}; nothing recorded")
    sha = res.stdout.strip()
    if git("merge-base", "--is-ancestor", sha, "HEAD").returncode != 0:
        fail(3, f"{head!r} is not in the history of {checkout!r}'s HEAD; nothing recorded")
    entry["head"] = sha
    write_entry(directory, lane, entry)


def read_events(directory):
    """Every valid event in ledger order (files by name, then lines)."""
    return [entry for _, _, entry in read_events_at(directory)]


def read_events_at(directory):
    """Every valid event as (file name, line number, event), in ledger order."""
    events = []
    if not os.path.isdir(directory):
        return events
    names = sorted(n for n in os.listdir(directory) if n.endswith(".jsonl"))
    for name in names:
        path = os.path.join(directory, name)
        try:
            with open(path, encoding="ascii") as f:
                text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            fail(3, f"cannot read {path}: {e}")
        lines = text.splitlines()
        # An append in progress: a last line with no newline yet that is not
        # JSON is skipped, not an error (appenders write JSON and newline in
        # one write, so a complete event always ends with a newline).
        partial = len(lines) if text and not text.endswith("\n") else None
        for number, line in enumerate(lines, 1):
            if not line.strip():
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                if number == partial:
                    continue
                entry = None
            error = "invalid JSON" if entry is None else entry_error(entry)
            if error:
                fail(3, f"{path}:{number}: {error}")
            events.append((name, number, entry))
    return events


def summarize(events, plan_text=None, plan_given=False, spec_sha=None, plan_sha=None, manifest=None):
    done, reviewed_by, blocked, start_points = {}, {}, {}, {}
    last_ruling, unblocked, deferred = {}, {}, {}
    review_event = {}
    history = {}  # task -> committed/settled events in order
    setup_hashes = None
    had_spec = False  # any launch's setup recorded a spec
    started = {}  # task -> base of its latest started event
    start_mismatch = {}  # task -> reason, the first one found
    spent = {"agents": 0, "rulings": 0}
    ended, launches, adjudicated = 0, 0, 0
    accepted = []
    for entry in events:
        task, event = entry["task"], entry["event"]
        if event in ("committed", "settled") and "base" in entry and task not in start_mismatch:
            want = started.get(task)
            if task not in history and want is not None and entry["base"] != want:
                start_mismatch[task] = (f"its first recorded range starts at {entry['base']}, not at the base "
                                        f"{want} it started at")
        if event == "started":
            evs = history.get(task)
            if evs and "base" in evs[0] and entry["base"] not in (evs[0]["base"], evs[-1].get("head")) \
                    and task not in start_mismatch:
                start_mismatch[task] = (f"it started at {entry['base']}, neither the task base "
                                        f"{evs[0]['base']} nor its last head")
            started[task] = entry["base"]
        elif event == "run_ended":
            spent["agents"] += entry["agents"]
            spent["rulings"] += entry["rulings"]
            ended += 1
        elif event == "accepted":
            accepted.append({"head": entry["head"], "text": entry["text"]})
        elif event == "committed":
            unblocked[task] = False
            deferred[task] = False
            last_ruling.pop(task, None)
            done[task] = True
            reviewed_by[task] = None
            blocked[task] = False
            history.setdefault(task, []).append(entry)
        elif event == "reviewed":
            if task in done:
                reviewed_by[task] = "review"
                review_event[task] = entry
        elif event == "settled":
            unblocked[task] = entry["outcome"] == "unblock"
            deferred[task] = True
            done[task] = True
            reviewed_by[task] = "settled"
            blocked[task] = False
            history.setdefault(task, []).append(entry)
        elif event == "reopened":
            if reviewed_by.get(task) == "review":
                reviewed_by[task] = None
        elif event == "blocked":
            blocked[task] = True
        elif event == "ruling" and entry["text"] and entry.get("by") == "adjudicator":
            last_ruling[task] = entry["text"]
            adjudicated += 1
        elif event == "run_started":
            if entry["phase"] == "setup":
                launches += 1
            key = START_POINTS[entry["phase"]]
            start_points.setdefault(key, entry["head"])
            # The latest launch's hashes: inputs report changes since then.
            if entry["phase"] == "setup" and "plan_sha256" in entry:
                setup_hashes = (entry.get("plan_sha256"), entry.get("spec_sha256"))
                had_spec = had_spec or entry.get("spec_sha256") is not None

    ranges, legacy, inconsistent = {}, [], []
    for task, evs in history.items():
        if any(e["event"] == "committed" and "base" not in e for e in evs):
            legacy.append(task)
            continue
        # An implement (or a rerun after an adjudication) and a settled event
        # cover the whole task from its base; a fix starts at the previous head.
        for prev, cur in zip(evs, evs[1:]):
            if cur["base"] not in (evs[0]["base"], prev["head"]):
                inconsistent.append({"task": task, "reason":
                                     f"an event starts at {cur['base']}, neither the task base "
                                     f"{evs[0]['base']} nor the previous head {prev['head']}"})
                break
        ranges[task] = {"base": evs[0]["base"], "head": evs[-1]["head"]}
    for task, reason in start_mismatch.items():
        if not any(i["task"] == task for i in inconsistent):
            inconsistent.append({"task": task, "reason": reason})

    inputs = {"plan_changed": None, "spec_changed": None}
    if setup_hashes is not None:
        if plan_sha is not None:
            inputs["plan_changed"] = setup_hashes[0] != plan_sha
        if spec_sha is not None or plan_given:
            # Without --spec there is no spec now (as for stale reviews): a
            # launch that recorded none did not change it.
            inputs["spec_changed"] = setup_hashes[1] != spec_sha

    stale, unbound = [], []
    if plan_given:
        for task, by in reviewed_by.items():
            if by != "review":
                continue
            rev = review_event[task]
            if "brief_sha256" not in rev:
                unbound.append(task)
                continue
            try:
                current = _brief.section_sha256(plan_text, task)
            except _brief.BriefError:
                stale.append({"task": task, "reason": "the plan has no section for this task now"})
                continue
            if current != rev["brief_sha256"]:
                stale.append({"task": task, "reason": "the task's section of the plan changed since its review"})
            elif "head" in rev and task in ranges and rev["head"] != ranges[task]["head"]:
                stale.append({"task": task, "reason":
                              f"the review approved {rev['head']}, not the recorded head {ranges[task]['head']}"})
            elif "spec_sha256" in rev:
                # No --spec means no spec now: a review that read one is stale.
                if rev["spec_sha256"] != spec_sha:
                    stale.append({"task": task, "reason": "the spec changed since its review"})
            elif spec_sha is not None or had_spec:
                # An approval from before 1.4.4 cannot show which spec it
                # read: in a run with a spec, now or at any launch, it is
                # reviewed again (a later setup record must not revive it).
                stale.append({"task": task, "reason":
                              "the review recorded no spec (it predates 1.4.4) and this run has one"})
    if manifest is not None and stale:
        # A dependent built on, or against, a stale approval is reviewed again
        # too: transitively, in run order.
        order = manifest_tasks(manifest)
        stale_ids = {s["task"] for s in stale}
        changed = True
        while changed:
            changed = False
            for t in order:
                tid = t["id"]
                if tid in stale_ids or reviewed_by.get(tid) != "review" or tid in unbound:
                    continue
                dep = next((d["id"] for d in t.get("depends_on") or []
                            if isinstance(d, dict) and d.get("id") in stale_ids), None)
                if dep is not None:
                    stale.append({"task": tid, "reason": f"it depends on {dep}, whose approval is stale"})
                    stale_ids.add(tid)
                    changed = True
    excluded = {s["task"] for s in stale} | set(unbound)

    # A launch whose session died records no run_ended; the rulings its
    # adjudicator wrote to the ledger still count.
    spent["rulings"] = max(spent["rulings"], adjudicated)
    spent["unrecorded_launches"] = max(0, launches - ended)

    undeclared = {}
    if manifest is not None:
        undeclared = annotated_undeclared(manifest, ranges)

    return {
        "done": list(done),
        "reviewed": [t for t, v in reviewed_by.items() if v and t not in excluded],
        "blocked": [t for t, v in blocked.items() if v],
        "deferred": [t for t, v in deferred.items() if v],
        "start_points": start_points,
        "carry": {t: last_ruling[t] for t, v in unblocked.items() if v and t in last_ruling},
        "ranges": ranges,
        "legacy": legacy,
        "inconsistent": inconsistent,
        "stale": stale,
        "unbound": unbound,
        "inputs": inputs,
        "spent": spent,
        "accepted": accepted,
        "undeclared": undeclared,
    }, history


def ruling_records(directory):
    """Every ruling as a dict: id (<file stem>-R<n>, n counting that file's
    rulings in append order), stem, file, line, role, scope and the event.
    A ruling with no by was written by a task agent before 1.6.3 and counts
    as an implementer's."""
    out = []
    counts = {}
    for name, number, e in read_events_at(directory):
        if e.get("event") != "ruling":
            continue
        stem = name[:-len(".jsonl")]
        counts[stem] = counts.get(stem, 0) + 1
        scope = e.get("scope") or ("run" if stem == "_run" else "lane")
        out.append({"id": f"{stem}-R{counts[stem]}", "stem": stem, "file": name, "line": number,
                    "role": e.get("by") or "implementer", "scope": scope, "event": e})
    return out


def carried_events(directory):
    return [e for e in read_events(directory) if e.get("event") == "carried"]


def resolve_overrides(records, carried):
    """{ruling id: [(target id, state)]}: state is known (a ruling of this
    ledger), pending (a PF-<n> no carried event bound yet: this launch's
    pre-flight ruling) or unknown. A PF-<n> resolves through the carried event
    that bound the ruling naming it (carry-launch)."""
    ids = {r["id"] for r in records}
    bound = {}
    for c in carried:
        for b in c.get("bound") or []:
            if isinstance(b, dict):
                bound[(b.get("file"), b.get("line"))] = c.get("pf") or {}
    out = {}
    for r in records:
        targets = []
        for o in r["event"].get("overrides") or []:
            if PF_ID.fullmatch(o):
                pf = bound.get((r["file"], r["line"]))
                if pf is None:
                    targets.append((o, "pending"))
                else:
                    mapped = pf.get(o)
                    targets.append((mapped or o, "known" if mapped in ids else "unknown"))
            else:
                targets.append((o, "known" if o in ids else "unknown"))
        out[r["id"]] = targets
    return out


def may_override(r, target):
    """Whether ruling r may override target: an adjudicator any ruling; a task
    agent only an implementer's or reviewer's ruling of its own lane file;
    pre-flight none."""
    if r["role"] == "adjudicator":
        return True
    if r["role"] in ("implementer", "reviewer"):
        return target["role"] in ("implementer", "reviewer") and target["stem"] == r["stem"]
    return False


OVERRIDE_NOTES = {"unknown": " (unknown)", "pending": " (this launch's pre-flight)", "against": " (against the rule)"}


def ruling_line(r, targets):
    """targets: [(id, state)], state known, unknown, pending or against."""
    e = r["event"]
    line = f"{r['id']} [{r['role']}, {e['task']}, {r['scope']}] {e['text']}"
    if targets:
        line += " (overrides " + ", ".join(t + OVERRIDE_NOTES.get(state, "") for t, state in targets) + ")"
    if e.get("files"):
        line += " (files " + ", ".join(e["files"]) + ")"
    return line


def ruling_view(directory, lane=None):
    """(shown records, {id: [(target, state)]}, {overridden id: by id}): the
    rulings shown (with lane: those of _run, the prelude and that lane, and
    every run-scope one), each one's override targets, and the overrides that
    take effect: within the rules, and only when the ruling that makes it is
    shown too."""
    records = ruling_records(directory)
    by_id = {r["id"]: r for r in records}
    overrides = resolve_overrides(records, carried_events(directory))

    def shown(r):
        return lane is None or r["stem"] in ("_run", "prelude", lane) or r["scope"] == "run"

    marked = {}
    overridden_by = {}
    for r in records:
        marked[r["id"]] = []
        for target, state in overrides[r["id"]]:
            if state == "known" and not may_override(r, by_id[target]):
                state = "against"
            marked[r["id"]].append((target, state))
            if state == "known" and shown(r):
                overridden_by.setdefault(target, r["id"])
    return [r for r in records if shown(r)], marked, overridden_by


def adjudicator_permits(directory, task_ids, declared=()):
    """[(path, ruling id)]: the files the adjudicator rulings in force permit
    for a unit of task_ids that declares the files declared: a ruling filed
    under one of task_ids, or under _run for a path that neither it nor a
    folder above it is named by a task's Files list in <directory>/owners.json
    (none of _run's without a readable owner map) and that sits in the folder
    of a declared file, or in a declared directory itself (_folder; folders
    compare by case). A permit names files only. Implementer, reviewer
    and pre-flight rulings permit nothing. task-checks counts these paths as
    declared."""
    shown, _marked, overridden_by = ruling_view(directory)
    try:
        owned = set(_owners.load(owners_path(directory))["files"])
    except (OSError, ValueError):
        owned = None
    folders = {_folder(d) for d in declared if _owners.path_key(d) is not None}
    out = []
    for r in shown:
        e = r["event"]
        if r["role"] != "adjudicator" or r["id"] in overridden_by:
            continue
        for path in e.get("files") or []:
            key = _owners.path_key(path)
            # A permit names files: a directory ("src/", "./") would cover every path under it.
            if not isinstance(path, str) or key in (None, ".") or path.endswith(("/", "\\")):
                continue
            if e.get("task") in task_ids or (e.get("task") == "_run" and owned is not None
                                             and not _owned_or_under(key, owned)
                                             and _folder(path, as_file=True) in folders):
                out.append((path, r["id"]))
    return out


def _folder(path, as_file=False):
    """The folder a declared path names, compared by case: a directory
    entry ('src/') is its own folder, a file's is its parent; '' is the
    project root. With as_file, path is always read as a file."""
    p = path.replace("\\", "/")
    folder = posixpath.normpath(p) if p.endswith("/") and not as_file else posixpath.dirname(posixpath.normpath(p))
    return "" if folder == "." else folder


def _owned_or_under(key, owned):
    """Whether the path key, or a folder above it, is in a Files list."""
    while key:
        if key in owned:
            return True
        key = posixpath.dirname(key)
    return False


def rulings(directory, lane=None):
    """Print the rulings in force, then the overridden ones. With lane: the
    rulings of _run, the prelude and that lane, and every run-scope one."""
    records, marked, overridden_by = ruling_view(directory, lane)
    in_force = [ruling_line(r, marked[r["id"]]) for r in records if r["id"] not in overridden_by]
    gone = [f"{r['id']} by {overridden_by[r['id']]}" for r in records if r["id"] in overridden_by]
    lines = in_force or ["(none)"]
    if gone:
        lines += ["Overridden:"] + gone
    for line in lines:
        print(line)


def load_manifest(manifest_path):
    """The manifest, with its task lists checked to be readable."""
    try:
        with open(manifest_path, encoding="utf-8") as f:
            m = json.load(f)
        m["repo"]["root"]
        task_lists(m)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, KeyError, TypeError) as e:
        fail(3, f"cannot read manifest {manifest_path!r}: {e}")
    return m


def task_lists(m):
    return [("prelude", m["prelude"])] + [(lane["id"], lane["tasks"]) for lane in m["lanes"]] \
        + [("join", m["join"])]


def manifest_tasks(m):
    return [t for _, tasks in task_lists(m) for t in tasks]


def repo_git(m):
    repo = m["repo"]
    prefix = [f"--git-dir={repo['git_dir']}"] if repo.get("mode") == "shadow" else ["-C", repo["root"]]

    def git(*args):
        return subprocess.run(["git", *prefix, *args], capture_output=True, text=True, encoding="utf-8",
                              errors="surrogateescape", env=ENV)
    return git


def path_key(path):
    """A project-relative path as validate.js compares it: normalized and
    lower-cased; None for an absolute path or one that leaves the project."""
    if not isinstance(path, str) or path.startswith("/"):
        return None
    norm = posixpath.normpath(path)
    if norm == ".." or norm.startswith("../"):
        return None
    return norm.lower()


def undeclared_files(m, ranges):
    git = repo_git(m)
    tasks = manifest_tasks(m)
    out = {}
    for t in tasks:
        tid = t["id"]
        rng = ranges.get(tid)
        if rng is None or not t.get("files"):
            continue
        # A batch shares one range: the files of every task on it are declared.
        allowed = set()
        for other in tasks:
            if ranges.get(other["id"]) == rng:
                allowed.update(k for k in map(path_key, other.get("files") or []) if k is not None)
        res = git("-c", "core.quotePath=false", "diff", "--name-only", "--no-renames", rng["base"], rng["head"])
        if res.returncode != 0:
            continue
        extra = sorted(p for p in res.stdout.splitlines() if p and path_key(p) not in allowed)
        if extra:
            out[tid] = extra
    return out


def latest_minors(events):
    """The latest open-minors snapshot (carry-launch), or None."""
    snaps = [e for e in events if e.get("event") == "minors"]
    return snaps[-1] if snaps else None


def overrides_list(directory):
    """Every ruling that names others it departs from: [{id, by, task,
    overrides, unknown}], overrides resolved (PF-n through carry-launch),
    unknown the ids that resolve to no ruling."""
    records = ruling_records(directory)
    by_id = {r["id"]: r for r in records}
    resolved = resolve_overrides(records, carried_events(directory))
    return [{"id": r["id"], "by": r["role"], "task": r["event"]["task"],
             "overrides": [t for t, _ in resolved[r["id"]]],
             "unknown": [t for t, state in resolved[r["id"]] if state == "unknown"],
             "targets": [{"id": t, "role": by_id[t]["role"], "lane": by_id[t]["stem"]}
                         for t, state in resolved[r["id"]] if state == "known"]}
            for r in records if resolved[r["id"]]]


def annotated_undeclared(manifest, ranges, owners=None):
    """undeclared_files with each path's owner: {task: [{path, owner,
    relation}]}, owner the first other task listing the path (None when no
    task does) and relation earlier, alongside or later (None likewise)."""
    owners = owners or _owners.build(manifest)
    out = {}
    for tid, paths in undeclared_files(manifest, ranges).items():
        rows = []
        for p in paths:
            owner, rel = _owners.first_owner(owners, [tid], p)
            rows.append({"path": p, "owner": owner, "relation": rel})
        out[tid] = rows
    return out


def manifest_from_owners(owners):
    """The parts of a manifest undeclared_files reads, rebuilt from an owner
    map: the repo, and each task with its Files in its list."""
    files_of = {}
    for key, ids in owners["files"].items():
        for tid in ids:
            files_of.setdefault(tid, []).append(key)
    lists = {}
    for tid, where in owners["tasks"].items():
        lists.setdefault(where["where"], []).append((where["pos"], {"id": tid, "files": files_of.get(tid, [])}))
    ordered = {w: [t for _, t in sorted(items, key=lambda x: x[0])] for w, items in lists.items()}
    return {"repo": owners.get("repo") or {}, "prelude": ordered.pop("prelude", []),
            "join": ordered.pop("join", []), "lanes": [{"id": w, "tasks": ts} for w, ts in ordered.items()]}


def owners_path(directory):
    return os.path.join(directory, "owners.json")


def load_owners(directory):
    try:
        return _owners.load(owners_path(directory))
    except (OSError, ValueError) as e:
        fail(3, f"cannot read the owner map {owners_path(directory)!r}: {e}")


def write_owners(directory, manifest_path):
    """Write <directory>/owners.json from the manifest (setup runs this)."""
    data = _owners.build(load_manifest(manifest_path))
    os.makedirs(directory, exist_ok=True)
    tmp = owners_path(directory) + ".tmp"
    try:
        _shell.write_text(tmp, json.dumps(data, indent=2) + "\n")
        os.replace(tmp, owners_path(directory))
    except OSError as e:
        fail(3, f"cannot write {owners_path(directory)!r}: {e}")
    print(json.dumps({"owners": owners_path(directory).replace("\\", "/"), "files": len(data["files"])}))


def owners(directory, unit_ids, paths):
    """Print what each path is, seen from the unit's tasks. An absolute path
    is taken relative to the current directory (the agent's checkout); one
    outside it, or a task the map does not know, is a usage error."""
    data = load_owners(directory)
    unknown = [t for t in unit_ids if t not in data["tasks"]]
    if unknown:
        fail(2, f"unknown task {unknown[0]!r}: not in the owner map")
    # Resolved on both sides: a symlinked temp or home dir (macOS /var is
    # /private/var) must not put a path inside the checkout outside it.
    here = os.path.realpath(os.getcwd())
    for p in paths:
        rel = p
        if os.path.isabs(p) or (len(p) > 1 and p[1] == ":"):
            full = os.path.realpath(p)
            try:
                inside = os.path.commonpath([full, here]) == here
            except ValueError:
                inside = False
            if not inside:
                fail(2, f"give {p!r} relative to the checkout {here!r}")
            rel = os.path.relpath(full, here).replace(os.sep, "/")
        print(f"{p} ({_owners.annotate(data, unit_ids, rel)})")


def undeclared(directory):
    """Print the owner-annotated files each task changed outside its Files
    list, from the owner map and the ledger's ranges."""
    data = load_owners(directory)
    result, _ = summarize(read_events(directory))
    print(json.dumps(annotated_undeclared(manifest_from_owners(data), result["ranges"], data)))


def status(directory, plan=None, spec=None, manifest_path=None):
    plan_text = read_text(plan, "plan") if plan is not None else None
    manifest = load_manifest(manifest_path) if manifest_path is not None else None
    events = read_events(directory)
    result, _ = summarize(events, plan_text, plan is not None,
                          file_sha256(spec) if spec is not None else None,
                          file_sha256(plan) if plan is not None else None, manifest)
    snap = latest_minors(events)
    result["minors"] = {"open": [m.get("id") for m in snap["open"]] if snap else [],
                        "covered": list(snap.get("covered") or []) if snap else []}
    result["overrides"] = overrides_list(directory)
    print(json.dumps(result))


WF_ID = re.compile(r"^wf_[a-z0-9-]{6,64}$")


def find_launch_file(source):
    """The Workflow result file of a launch: source is its transcript dir, or
    its wf id (a launch whose session died), looked up under the Claude config
    dir as projects/*/*/workflows/<wf>.json. None when there is none."""
    if WF_ID.fullmatch(source) and not os.path.isdir(source):
        config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
        found = sorted(glob.glob(os.path.join(glob.escape(config), "projects", "*", "*", "workflows", source + ".json")))
        return found[0] if found else None
    for path in _shell.result_paths(source):
        if os.path.isfile(path):
            return path
    return None


def open_minors(previous, result, args):
    """The task minors still open after a launch, and the tasks covered.

    previous is the last snapshot event (or None). A task done in this launch
    replaces its entries with its approving review's minors less those this
    launch's final review raised (none raised without a final review). A
    carried minor this launch's final raised drops out."""
    prev_open = list((previous or {}).get("open") or [])
    covered = list((previous or {}).get("covered") or [])
    tasks = result.get("tasks") if isinstance(result.get("tasks"), dict) else {}
    final = result.get("final") if isinstance(result.get("final"), dict) else None
    done_here = [t for t, v in tasks.items() if isinstance(v, dict) and v.get("status") == "done"]
    carried_open = ((args or {}).get("carried_minors") or {}).get("open") or []
    # A final review that reports no carried_minors_open raised none of them.
    if final is not None and isinstance(final.get("carried_minors_open"), list):
        still_carried = set(final["carried_minors_open"])
    else:
        still_carried = set(carried_open)
    raised_carried = set(carried_open) - still_carried
    task_open = None if final is None else {m.get("id") for m in final.get("task_minors_open") or []
                                            if isinstance(m, dict)}
    out = [m for m in prev_open if m.get("task") not in done_here and m.get("id") not in raised_carried]
    seen = {m.get("id") for m in out}
    for t in done_here:
        minors = tasks[t].get("minor_findings")
        if not isinstance(minors, list):
            continue
        if t not in covered:
            covered.append(t)
        for m in minors:
            if not isinstance(m, dict) or m.get("id") in seen:
                continue
            if task_open is not None and m.get("id") not in task_open:
                continue
            seen.add(m.get("id"))
            out.append({"id": m.get("id"), "task": t, "file": m.get("file"), "line": m.get("line"),
                        "issue": m.get("issue"), "fix": m.get("fix")})
    return out, covered


def launch_order(directory):
    """{wf id: n}: the setup event each launch's doctor-<wf>.json names (the
    nth setup run_started in _run.jsonl), from ledger conditions."""
    order = {}
    try:
        names = os.listdir(directory)
    except OSError:
        return order
    for name in names:
        if not (name.startswith("doctor-") and name.endswith(".json")):
            continue
        try:
            with open(os.path.join(directory, name), encoding="utf-8") as f:
                launch = json.load(f).get("launch") or {}
        except (OSError, ValueError, AttributeError):
            continue
        if is_text(launch.get("wf")) and isinstance(launch.get("setup_event"), int):
            order[launch["wf"]] = launch["setup_event"]
    return order


def setup_window(directory, n):
    """(first line, end line) of launch n's events in _run.jsonl: after its
    setup run_started, before the next one; None when n is unknown."""
    if not isinstance(n, int):
        return None
    starts = [number for name, number, e in read_events_at(directory)
              if name == "_run.jsonl" and e.get("event") == "run_started" and e.get("phase") == "setup"]
    if n < 1 or n > len(starts):
        return None
    return starts[n - 1], (starts[n] if n < len(starts) else float("inf"))


def carry_launch(directory, source):
    """Record what a launch knew that the ledger does not: pre-flight's own
    rulings (by preflight, PF-n), the open task minors, and which PF-n
    overrides recorded during the launch name. Once per wf id."""
    if not os.path.isdir(directory):
        fail(3, f"no ledger dir {directory!r}")
    path = find_launch_file(source)
    try:
        data = json.loads(read_text(path, "launch result")) if path else None
    except ValueError:
        data = None
    result = data.get("result") if isinstance(data, dict) else None
    if not isinstance(result, dict):
        fail(3, f"no readable workflow result for {source!r}")
    wf = data.get("runId") if is_text(data.get("runId")) else os.path.basename(source.rstrip("/\\"))
    events = read_events(directory)
    if any(e.get("event") == "carried" and e.get("wf") == wf for e in events):
        print(json.dumps({"carried": wf, "already": True}))
        return
    pre = result.get("preflight") if isinstance(result.get("preflight"), dict) else {}
    texts = [t for t in pre.get("rulings") or [] if isinstance(t, str)]
    adjudicated = pre.get("adjudicated")
    order = launch_order(directory)
    carried_wfs = {e.get("wf") for e in events if e.get("event") == "carried"}
    if wf in order:
        missing = [w for w, n in sorted(order.items(), key=lambda x: x[1])
                   if n < order[wf] and w not in carried_wfs]
        if missing:
            fail(3, f"carry the earlier launch {missing[0]} first (launches are carried in launch order)")
    already_mapped = {v for c in carried_events(directory) for v in (c.get("pf") or {}).values()}
    window = setup_window(directory, order.get(wf))
    adj_ids = [r["id"] for r in ruling_records(directory)
               if r["stem"] == "_run" and r["role"] == "adjudicator" and r["id"] not in already_mapped
               and (window is None or window[0] < r["line"] < window[1])]
    if "adjudicated" not in pre and pre.get("conflicts") and texts and adj_ids:
        # A 1.6.2 result has no marker: its engine adjudicated pre-flight
        # conflicts only in autonomous runs and pushed the ruling last. With no
        # adjudicator ruling in _run (a supervised stop) there was none.
        adjudicated = len(texts) - 1
    pf = {}
    entries = []
    run_rulings = len([r for r in ruling_records(directory) if r["stem"] == "_run"])
    for i, text in enumerate(texts):
        key = f"PF-{i + 1}"
        if isinstance(adjudicated, int) and not isinstance(adjudicated, bool) and i == adjudicated:
            if adj_ids:
                pf[key] = adj_ids[-1]
            continue
        entries.append({"task": "_run", "event": "ruling", "text": text, "by": "preflight",
                        "scope": "run", "pf": key, "wf": wf})
        pf[key] = f"_run-R{run_rulings + len(entries)}"
    written = len(entries)
    bound_before = {(b.get("file"), b.get("line")) for c in carried_events(directory)
                    for b in c.get("bound") or [] if isinstance(b, dict)}
    bound = [{"file": r["file"], "line": r["line"]} for r in ruling_records(directory)
             if any(PF_ID.fullmatch(o) for o in r["event"].get("overrides") or [])
             and (r["file"], r["line"]) not in bound_before]
    open_now, covered = open_minors(latest_minors(events), result, data.get("args"))
    entries.append({"task": "_run", "event": "minors", "wf": wf, "open": open_now, "covered": covered})
    entries.append({"task": "_run", "event": "carried", "wf": wf, "pf": pf, "bound": bound})
    append_entries(directory, "_run", entries)
    print(json.dumps({"carried": wf, "rulings": written, "open_minors": len(open_now)}))


def minors(directory):
    """Print the task minors still open (the latest snapshot)."""
    snap = latest_minors(read_events(directory))
    entries = (snap or {}).get("open") or []
    if not entries:
        print("(none)")
    for m in entries:
        print(f"[{m.get('id')}] {m.get('task')} {m.get('file')}:{m.get('line')} - {m.get('issue')} "
              f"(fix: {m.get('fix')})")


def accept(directory, checkout, head, text):
    if not text:
        fail(2, "TEXT must say what the user accepted")
    res = subprocess.run(["git", "-C", checkout, "rev-parse", "--verify", "--quiet", "--end-of-options",
                          f"{head}^{{commit}}"], capture_output=True, text=True, encoding="utf-8",
                         errors="surrogateescape", env=ENV)
    if res.returncode != 0 or not res.stdout.strip():
        fail(3, f"{head!r} is not a commit in {checkout!r}; nothing recorded")
    write_entry(directory, "_run", {"task": "_run", "event": "accepted", "head": res.stdout.strip(), "text": text})


COUNT = re.compile(r"[0-9]+")


def ended(directory, status_text, agents, rulings):
    for name, value in (("AGENTS", agents), ("RULINGS", rulings)):
        if not COUNT.fullmatch(value):
            fail(2, f"{name} must be an integer >= 0, not {value!r}; nothing recorded")
    write_entry(directory, "_run", {"task": "_run", "event": "run_ended", "status": status_text,
                                    "agents": int(agents), "rulings": int(rulings)})


def backfill(directory, manifest_path):
    m = load_manifest(manifest_path)
    lists = task_lists(m)
    git = repo_git(m)

    summary, history = summarize(read_events(directory))
    done = set(summary["done"])
    starts = m.get("start_points") or summary["start_points"]
    out, derived, errors = {}, [], []
    for item in summary["inconsistent"]:
        errors.append(f"task {item['task']}: {item['reason']}")
    prelude_head = None
    for name, tasks in lists:
        # Where a legacy first task of the list starts: the feature tip setup
        # recorded (prelude), the prelude's last head (a lane), or the join
        # start point integration recorded (join).
        if name == "prelude":
            prev = starts.get("prelude")
        elif name == "join":
            prev = starts.get("join")
        else:
            prev = prelude_head or starts.get("prelude")
        for t in tasks:
            tid = t["id"]
            if tid not in done:
                break
            evs = history.get(tid, [])
            if tid in summary["ranges"]:
                rng = summary["ranges"][tid]
            elif evs:
                last = evs[-1]
                head = last.get("head") or last["commits"][-1]
                if prev is None:
                    errors.append(f"task {tid}: no recorded base and no start point to derive one from")
                    break
                rng = {"base": prev, "head": head}
                derived.append(tid)
            else:
                errors.append(f"task {tid}: done but has no committed or settled event")
                break
            check = git("merge-base", "--is-ancestor", rng["base"], rng["head"])
            if check.returncode != 0:
                errors.append(f"task {tid}: {rng['base']} is not an ancestor of {rng['head']} in the repo")
            for e in evs:
                if e["event"] == "committed" and "base" in e:
                    listed = git("rev-list", "--reverse", f"{e['base']}..{e['head']}")
                    if listed.returncode != 0 or listed.stdout.split() != e["commits"]:
                        errors.append(f"task {tid}: recorded commits differ from git rev-list "
                                      f"{e['base']}..{e['head']}")
                        break
            out[tid] = rng
            prev = rng["head"]
        if name == "prelude":
            prelude_head = prev
    print(json.dumps({"backfill": out, "derived": derived, "errors": errors}))
    if errors:
        sys.exit(3)


WF_ID = re.compile(r"wf_[a-z0-9-]{6,64}")
TIMESTAMP = "%Y-%m-%dT%H:%M:%SZ"
REFUSALS = {
    "wf_recorded": "this wf already has a different launch conditions snapshot",
    "not_doctor": "the doctor file has no status or no observed_at of the form YYYY-MM-DDTHH:MM:SSZ",
    "no_setup": "the ledger has no setup run_started event",
    "setup_recorded": "another snapshot already names this setup event",
    "observation_reused": "another snapshot has the same observed_at (run doctor again)",
}


def read_json_object(path):
    """The JSON object in path, or None when it cannot be read as one."""
    try:
        with open(path, encoding="utf-8") as f:
            value = json.load(f)
    except (OSError, ValueError, RecursionError):
        return None
    return value if isinstance(value, dict) else None


def is_timestamp(value):
    if not isinstance(value, str):
        return False
    try:
        time.strptime(value, TIMESTAMP)
    except ValueError:
        return False
    return True


def refuse(code):
    print(json.dumps({"refused": code}))
    print(f"ledger: conditions refused {code}: {REFUSALS[code]}; nothing written", file=sys.stderr)
    sys.exit(3)


def conditions(directory, wf_id, doctor_file):
    if not WF_ID.fullmatch(wf_id):
        fail(2, f"WF_ID {wf_id!r} must match ^wf_[a-z0-9-]{{6,64}}$")
    doctor = read_json_object(doctor_file)
    if doctor is None:
        fail(2, f"cannot read a JSON object from the doctor file {doctor_file!r}")
    setups = [e for e in read_events(directory)
              if e["task"] == "_run" and e["event"] == "run_started" and e["phase"] == "setup"]
    n = len(setups)
    launch = {"wf": wf_id, "setup_event": n, "setup_head": setups[-1]["head"] if setups else None}
    name = f"doctor-{wf_id}.json"
    target = os.path.join(directory, name)
    done = {"recorded": name, "setup_event": n}
    if os.path.lexists(target):
        existing = read_json_object(target)
        if existing is not None and existing.get("launch") == launch and existing.get("doctor") == doctor:
            print(json.dumps(done))
            return
        refuse("wf_recorded")
    observed_at = doctor.get("observed_at")
    if "status" not in doctor or not is_timestamp(observed_at):
        refuse("not_doctor")
    if n == 0:
        refuse("no_setup")
    others = []
    for other in sorted(os.listdir(directory)):
        if other.startswith("doctor-") and other.endswith(".json") and other != name:
            snap = read_json_object(os.path.join(directory, other))
            if snap is not None:
                others.append(snap)

    def field(snap, part, key):
        value = snap.get(part)
        return value.get(key) if isinstance(value, dict) else None

    # type() keeps a hand-made true from counting as setup event 1.
    if any(type(field(s, "launch", "setup_event")) is int and field(s, "launch", "setup_event") == n
           for s in others):
        refuse("setup_recorded")
    if any(field(s, "doctor", "observed_at") == observed_at for s in others):
        refuse("observation_reused")
    snapshot = {"launch": launch, "recorded_at": time.strftime(TIMESTAMP, time.gmtime()), "doctor": doctor}
    # A temp name outside doctor-*.json, which autopsy reads as snapshots.
    tmp = os.path.join(directory, f".conditions-{os.getpid()}.tmp")
    try:
        _shell.write_text(tmp, json.dumps(snapshot, indent=2) + "\n")
        os.replace(tmp, target)
    except OSError as e:
        try:
            os.remove(tmp)
        except OSError:
            pass
        fail(3, f"cannot write {target!r}: {e}")
    print(json.dumps(done))


PATH_ARGS = {"append": (1,), "reviewed": (1, 5, 6, 9), "status": (1,), "backfill": (1, 2), "accept": (1, 2),
             "ended": (1,), "conditions": (1, 3), "rulings": (1,), "minors": (1,), "carry-launch": (1,), "write-owners": (1, 2), "owners": (1,),
             "undeclared": (1,)}
PATH_OPTIONS = ("--plan", "--spec", "--manifest")


def native_args(argv):
    """argv with each path argument in the one Windows form (unchanged elsewhere)."""
    if not argv:
        return argv
    positions = PATH_ARGS.get(argv[0], ())
    return [
        _shell.native_path(a) if i in positions or (i > 0 and argv[0] == "status" and argv[i - 1] in PATH_OPTIONS) else a
        for i, a in enumerate(argv)
    ]


def main(argv):
    _shell.setup_io()
    try:
        argv = native_args(argv)
    except _shell.BashNotFound as e:
        fail(3, str(e))
    if len(argv) == 4 and argv[0] == "append" and argv[1]:
        append(argv[1], argv[2], argv[3])
    elif len(argv) in (9, 10) and argv[0] == "reviewed" and all(argv[1:]):
        if not LANE.fullmatch(argv[3]):
            fail(3, f"unsafe task id {argv[3]!r}")
        reviewed(*argv[1:])
    elif len(argv) >= 2 and argv[0] == "status" and argv[1]:
        opts = {"--plan": None, "--spec": None, "--manifest": None}
        rest = argv[2:]
        while rest:
            if len(rest) < 2 or rest[0] not in opts or opts[rest[0]] is not None or not rest[1]:
                fail(2, "usage: ledger status DIR [--plan PLAN] [--spec SPEC] [--manifest MANIFEST]")
            opts[rest[0]] = rest[1]
            rest = rest[2:]
        status(argv[1], opts["--plan"], opts["--spec"], opts["--manifest"])
    elif len(argv) == 3 and argv[0] == "backfill" and argv[1] and argv[2]:
        backfill(argv[1], argv[2])
    elif len(argv) == 5 and argv[0] == "accept" and all(argv[1:4]):
        accept(*argv[1:])
    elif len(argv) == 5 and argv[0] == "ended" and argv[1]:
        ended(*argv[1:])
    elif len(argv) == 4 and argv[0] == "conditions" and argv[1] and argv[3]:
        conditions(*argv[1:])
    elif argv[:1] == ["rulings"] and len(argv) in (2, 4) and argv[1] and (len(argv) == 2 or argv[2] == "--lane"):
        rulings(argv[1], argv[3] if len(argv) == 4 and argv[3] != "-" else None)
    elif len(argv) == 2 and argv[0] == "minors" and argv[1]:
        minors(argv[1])
    elif len(argv) == 3 and argv[0] == "write-owners" and argv[1] and argv[2]:
        write_owners(argv[1], argv[2])
    elif len(argv) == 2 and argv[0] == "undeclared" and argv[1]:
        undeclared(argv[1])
    elif len(argv) >= 4 and argv[0] == "owners" and argv[1] and argv[2] == "--task":
        rest, unit = argv[2:], []
        while len(rest) >= 2 and rest[0] == "--task":
            if not LANE.fullmatch(rest[1]):
                fail(2, f"unsafe task id {rest[1]!r}")
            unit.append(rest[1])
            rest = rest[2:]
        if not unit or not rest or any(a == "--task" for a in rest):
            fail(2, "usage: ledger owners DIR --task ID [--task ID ...] PATH ...")
        owners(argv[1], unit, rest)
    elif len(argv) == 3 and argv[0] == "carry-launch" and argv[1] and argv[2]:
        source = argv[2] if WF_ID.fullmatch(argv[2]) else _shell.native_path(argv[2])
        carry_launch(argv[1], source)
    else:
        fail(2, "usage: ledger append DIR LANE JSON"
                " | ledger reviewed DIR LANE TASK ROUNDS PLAN CHECKOUT HEAD BLOCKING [SPEC]"
                " | ledger status DIR [--plan PLAN] [--spec SPEC] [--manifest MANIFEST] | ledger backfill DIR MANIFEST"
                " | ledger accept DIR CHECKOUT HEAD TEXT | ledger ended DIR STATUS AGENTS RULINGS"
                " | ledger conditions DIR WF_ID DOCTOR_FILE | ledger rulings DIR [--lane LANE]"
                " | ledger carry-launch DIR TRANSCRIPT_DIR|WF_ID | ledger minors DIR"
                " | ledger write-owners DIR MANIFEST | ledger owners DIR --task ID [--task ID ...] PATH ..."
                " | ledger undeclared DIR")


if __name__ == "__main__":
    main(sys.argv[1:])
