#!/usr/bin/env python3
"""Reserve a check's result file, and wait for the check that writes it.

usage: await-checks reserve --ledger LEDGER --name NAME [--exact]
       await-checks wait FILE [--max SECONDS]

An agent runs a check in three calls: reserve (foreground), the check itself
in the background with its result path set to the reserved FILE (run-checks
--out FILE, task-checks --evidence FILE), then wait (foreground), repeated
while it exits 4.

reserve: NAME is a safe file name (^[A-Za-z0-9_][A-Za-z0-9._-]*$) and LEDGER
an existing directory. It creates <LEDGER>/checks/<NAME>.<n>.json, empty and
exclusively (O_EXCL), with n the first free number from 1, and prints its
path. With --exact the path is <LEDGER>/checks/<NAME>.json: while a writer
holds that path's check-file lock (_await), reserve writes nothing, prints
{"status": "busy", "file": PATH} and exits 4 (wait on PATH until it no longer
exits 4, then reserve again); otherwise the file is created, or emptied when
it exists. The path must resolve inside LEDGER and must not be a symlink. On
success stdout is the path alone, in the C:/... form on Windows. Exit 0 when
the path is printed, 4 busy (--exact only), 2 on a usage error (an unsafe
NAME, a missing LEDGER, a path outside LEDGER or a symlink; nothing is
written), 3 on any other error.

wait: polls FILE every 2 s for up to --max seconds (default 540, allowed
1-570). A report counts only once its writer is gone: on each poll wait first
checks the check-file lock without waiting (_await.writer_alive), and reads
FILE only when no writer holds it. FILE is opened, read and closed on each
read, never held open between polls.
  - FILE holds a complete report (a JSON object with a boolean "ok"): stdout
    is its JSON line exactly as the writer wrote it; exit 0 when ok, 1 when
    not. When the report has "tree_changed": true, stderr gets one line:
    "await-checks: the checkout changed while the checks ran; rerun them".
  - FILE holds an error record (an object with an "error" key, such as
    task-checks' exit-3 record): stdout is the record; exit 3.
  - Still running at --max: stdout is
    {"status": "running", "file": FILE, "waited_s": N}; exit 4.
  - No writer holds the lock, FILE is empty (or missing), and the start grace
    has passed: stdout is {"status": "stopped", "file": FILE, "reason": R};
    exit 5. R is "died" when this wait saw the lock held earlier, or when a
    sidecar FILE.lock exists that no one holds (a killed writer leaves it);
    otherwise "not_started".
  - FILE holds anything else once no writer holds the lock and the grace has
    passed: exit 3, with a message on stderr.
The start grace is 60 s from the later of FILE's mtime and the start of this
wait: a writer whose interpreter is slow to start is still running, not
stopped. The environment variable AWAIT_CHECKS_GRACE_S replaces the 60 s; it
exists for the tests only. Exit 2 on a usage error, 3 on any other error.

On Windows LEDGER and FILE may be given in any form (C:\\x, /c/x, /tmp/x);
the paths printed are in the C:/... form.
"""

import json
import os
import re
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _await  # noqa: E402
import _shell  # noqa: E402

USAGE = ("usage: await-checks reserve --ledger LEDGER --name NAME [--exact]\n"
         "       await-checks wait FILE [--max SECONDS]")
NAME = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*")
SECONDS = re.compile(r"[0-9]+")
DEFAULT_MAX_S = 540
MAX_MAX_S = 570
POLL_S = 2
GRACE_S = 60
TREE_CHANGED = "await-checks: the checkout changed while the checks ran; rerun them"

_BINARY = getattr(os, "O_BINARY", 0)
_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)


def fail(code, message):
    print(f"await-checks: {message}", file=sys.stderr)
    sys.exit(code)


# --- reserve -----------------------------------------------------------------

def parse_reserve(args):
    ledger = name = None
    exact = False
    while args:
        if args[0] == "--exact" and not exact:
            exact = True
            args = args[1:]
        elif args[0] == "--ledger" and len(args) >= 2 and args[1] and ledger is None:
            ledger = args[1]
            args = args[2:]
        elif args[0] == "--name" and len(args) >= 2 and name is None:
            name = args[1]
            args = args[2:]
        else:
            fail(2, USAGE)
    if ledger is None or name is None:
        fail(2, USAGE)
    if not NAME.fullmatch(name):
        fail(2, f"unsafe name {name!r}: use letters, digits, '.', '_' and '-', not first '.' or '-'")
    ledger = _shell.native_path(ledger)
    if not os.path.isdir(ledger):
        fail(2, f"ledger {ledger!r} is not a directory")
    return ledger, name, exact


def check_inside(path, ledger):
    """Exit 2 unless path resolves inside ledger and is not a symlink."""
    if os.path.islink(path) or not _shell.contained(path, ledger):
        fail(2, f"path {path!r} is outside the ledger {ledger!r} or a symlink")


def reserve(ledger, name, exact):
    """Create the result file (see the docstring) and print its path."""
    checks = os.path.join(ledger, "checks")
    check_inside(checks, ledger)
    os.makedirs(checks, exist_ok=True)
    # Again once it exists: it may have been made a link in the meantime.
    check_inside(checks, ledger)
    if exact:
        path = os.path.join(checks, name + ".json")
        check_inside(path, ledger)
        if _await.writer_alive(path):
            print(json.dumps({"status": "busy", "file": _shell.native_path(path)}))
            sys.exit(4)
        os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | _BINARY | _NOFOLLOW, 0o644))
    else:
        n = 1
        while True:
            path = os.path.join(checks, f"{name}.{n}.json")
            check_inside(path, ledger)
            try:
                os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | _BINARY, 0o644))
                break
            except FileExistsError:
                n += 1
    print(_shell.native_path(path))


# --- wait --------------------------------------------------------------------

def parse_wait(args):
    if not args or not args[0] or args[0].startswith("-"):
        fail(2, USAGE)
    path, rest = args[0], args[1:]
    max_s = None
    while rest:
        if rest[0] == "--max" and len(rest) >= 2 and max_s is None and SECONDS.fullmatch(rest[1]):
            max_s = int(rest[1])
            if not 1 <= max_s <= MAX_MAX_S:
                fail(2, f"--max must be 1-{MAX_MAX_S} seconds")
            rest = rest[2:]
        else:
            fail(2, USAGE)
    return _shell.native_path(path), DEFAULT_MAX_S if max_s is None else max_s


def grace_s():
    """GRACE_S, or AWAIT_CHECKS_GRACE_S when it holds a number >= 0 (tests
    only)."""
    value = os.environ.get("AWAIT_CHECKS_GRACE_S")
    if value:
        try:
            seconds = float(value)
        except ValueError:
            return GRACE_S
        if seconds >= 0:
            return seconds
    return GRACE_S


def size_and_mtime(path):
    """(size, mtime) of path; (0, None) when it is missing."""
    try:
        st = os.stat(path)
    except FileNotFoundError:
        return 0, None
    return st.st_size, st.st_mtime


def report_line(path, report):
    """The report's line as the writer wrote it: FILE's text without its line
    end, when that is one line holding exactly report; else report as JSON."""
    try:
        with open(path, "rb") as f:
            text = f.read().decode("utf-8").rstrip("\r\n")
        if "\n" not in text and "\r" not in text and json.loads(text) == report:
            return text
    except (OSError, ValueError):
        pass
    return json.dumps(report)


def finish(path, report):
    """Print a complete report or an error record and exit with its code."""
    print(report_line(path, report))
    if "error" in report:
        sys.exit(3)
    if report.get("tree_changed") is True:
        print(TREE_CHANGED, file=sys.stderr)
    sys.exit(0 if report["ok"] else 1)


def wait(path, max_s):
    begin = time.monotonic()
    started = time.time()
    grace = grace_s()
    seen_held = False
    while True:
        if _await.writer_alive(path):
            seen_held = True
        else:
            report = _await.read_report(path)
            if report is not None and ("error" in report or isinstance(report.get("ok"), bool)):
                finish(path, report)
            size, mtime = size_and_mtime(path)
            if time.time() >= max(started, mtime or started) + grace:
                if report is not None or size > 0:
                    fail(3, f"{path} holds no check report and no writer holds its lock")
                died = seen_held or os.path.lexists(path + _await.SIDECAR)
                print(json.dumps({"status": "stopped", "file": path,
                                  "reason": "died" if died else "not_started"}))
                sys.exit(5)
        waited = time.monotonic() - begin
        if waited >= max_s:
            print(json.dumps({"status": "running", "file": path, "waited_s": int(waited)}))
            sys.exit(4)
        time.sleep(min(POLL_S, max_s - waited))


def main(argv):
    _shell.setup_io()
    if not argv:
        fail(2, USAGE)
    try:
        if argv[0] == "reserve":
            reserve(*parse_reserve(argv[1:]))
        elif argv[0] == "wait":
            wait(*parse_wait(argv[1:]))
        else:
            fail(2, USAGE)
    except (OSError, _shell.BashNotFound) as e:
        fail(3, str(e))
    except Exception as e:  # noqa: BLE001 - any other failure is exit 3, never a traceback's 1
        fail(3, f"{type(e).__name__}: {e}")


if __name__ == "__main__":
    main(sys.argv[1:])
