#!/usr/bin/env bash
# Build run.workflow.js from the modules in src/.
#
# usage: build [--out FILE]
#
# Concatenates, in this order: the meta literal of src/main.js (through its
# first line that is exactly "};"), a generated-file comment, rules,
# validate, plan, prompts-task, prompts-phase, adjudicator, budget, engine,
# phases, and the rest of src/main.js (the script body). Writes
# run.workflow.js beside src/ by default; --out FILE writes FILE instead, and
# --out - writes to stdout.
set -euo pipefail

usage() {
  echo "usage: build [--out FILE]" >&2
  exit 2
}

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
src="$root/src"
out="$root/run.workflow.js"

while [ $# -gt 0 ]; do
  case "$1" in
    --out)
      [ $# -ge 2 ] || usage
      out="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

modules=(rules validate plan prompts-task prompts-phase adjudicator budget engine phases)

for name in main "${modules[@]}"; do
  if [ ! -f "$src/$name.js" ]; then
    echo "build: missing $src/$name.js" >&2
    exit 1
  fi
done
if ! head -n 1 "$src/main.js" | grep -q '^export const meta = '; then
  echo "build: $src/main.js must begin with \"export const meta = \"" >&2
  exit 1
fi
if ! grep -qx '};' "$src/main.js"; then
  echo "build: $src/main.js has no line \"};\" closing the meta literal" >&2
  exit 1
fi

emit() {
  # The meta literal, through the first line that is exactly "};".
  awk '{ print } $0 == "};" { exit }' "$src/main.js"
  echo '// Generated by scripts/build from src/ - do not edit.'
  local name
  for name in "${modules[@]}"; do
    echo
    cat "$src/$name.js"
  done
  echo
  # The script body: everything after the meta literal, without the blank
  # lines that separate it from the literal.
  awk 'state == 2 { print; next }
       state == 1 && $0 == "" { next }
       state == 1 { state = 2; print; next }
       $0 == "};" { state = 1 }' "$src/main.js"
}

if [ "$out" = "-" ]; then
  emit
else
  tmp="$out.tmp.$$"
  trap 'rm -f "$tmp"' EXIT
  emit > "$tmp"
  mv "$tmp" "$out"
  trap - EXIT
fi
