#!/usr/bin/env python3
"""Closing bookkeeping for an implementer, a fix agent, or a settled task.

usage: finish-task DIR BRANCH FROM LEDGER_DIR LANE
                   --task ID [--task ID ...] [--commit SHA ...]
                   [--settled park|unblock]

The task range is FROM..HEAD of DIR, read from git: FROM is the base the
script owns (the task base, or the previous head for a fix), HEAD is DIR's
current commit, and the commits are every commit git rev-list --reverse
FROM..HEAD lists. Nothing an agent types decides the range; each --commit SHA
(optional) is only cross-checked against it.

Refuses with exit 3, recording nothing, when DIR's branch
(git rev-parse --abbrev-ref HEAD) is not BRANCH, when FROM or a SHA does not
resolve to a commit, when FROM is not an ancestor of HEAD, when a SHA is not
in FROM..HEAD, when FROM..HEAD is empty (except with --settled), when an ID
or LANE is not a safe name, or when LEDGER_DIR exists and is not a directory.
Everything is checked before the first append, so only a failed ledger write
can leave a partial record (the events before it); a rerun then repeats those
events, which ledger status tolerates.

Then appends, for every ID, via scripts/ledger append LEDGER_DIR LANE:
  {"task": ID, "event": "committed", "base": <FROM sha>, "head": <HEAD sha>,
   "commits": [<FROM..HEAD shas, oldest first>]}
or with --settled OUTCOME (the adjudicator parked or unblocked the task):
  {"task": ID, "event": "settled", "outcome": OUTCOME, "base": <FROM sha>,
   "head": <HEAD sha>, "commits": [...]}   (commits may be empty)
and prints one JSON line:
  {"base": <FROM sha>, "head": <HEAD sha>, "changed_lines": <insertions plus
   deletions of git diff --shortstat FROM HEAD, 0 when empty>,
   "commits": [...], "branch": BRANCH}

GIT_DIR, GIT_WORK_TREE, GIT_INDEX_FILE, GIT_OBJECT_DIRECTORY and
GIT_COMMON_DIR are removed from the environment of every git and ledger call,
so DIR alone names the repository.

Exit 0 on success; 1 if a git command fails; 2 on usage error; 3 on a refusal;
the ledger's code if an append fails.
"""

import argparse
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, HERE)
import _shell  # noqa: E402

SHORTSTAT = re.compile(r"(\d+) (insertion|deletion)")
# Variables that would point git at another repo than the one named.
GIT_REDIRECTS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
                 "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR")
# The lane and task names scripts/ledger and src/validate.js accept.
SAFE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$")
ENV = {k: v for k, v in os.environ.items() if k not in GIT_REDIRECTS}


def fail(code, message):
    print(f"finish-task: {message}", file=sys.stderr)
    sys.exit(code)


def git(directory, *args):
    return subprocess.run(
        ["git", "-C", directory, *args], capture_output=True, text=True, env=ENV
    )


def commit_sha(directory, ref):
    res = git(directory, "rev-parse", "--verify", "--quiet", "--end-of-options", f"{ref}^{{commit}}")
    if res.returncode != 0 or not res.stdout.strip():
        fail(3, f"{ref!r} does not resolve to a commit in {directory!r}")
    return res.stdout.strip()


def is_ancestor(directory, older, newer):
    res = git(directory, "merge-base", "--is-ancestor", older, newer)
    if res.returncode not in (0, 1):
        fail(1, f"git merge-base failed in {directory!r}: {res.stderr.strip()}")
    return res.returncode == 0


def parse(argv):
    parser = argparse.ArgumentParser(prog="finish-task")
    parser.add_argument("dir", metavar="DIR")
    parser.add_argument("branch", metavar="BRANCH")
    parser.add_argument("from_", metavar="FROM")
    parser.add_argument("ledger_dir", metavar="LEDGER_DIR")
    parser.add_argument("lane", metavar="LANE")
    parser.add_argument("--task", action="append", required=True, metavar="ID")
    parser.add_argument("--commit", action="append", default=[], metavar="SHA")
    parser.add_argument("--settled", choices=("park", "unblock"))
    return parser.parse_args(argv)


def main(argv):
    _shell.setup_io()
    args = parse(argv)
    try:
        directory = _shell.native_path(args.dir)
        args.ledger_dir = _shell.native_path(args.ledger_dir)
    except _shell.BashNotFound as e:
        fail(3, f"{e}; nothing recorded")

    if not SAFE.fullmatch(args.lane):
        fail(3, f"unsafe lane name {args.lane!r}; nothing recorded")
    for task in args.task:
        if not SAFE.fullmatch(task):
            fail(3, f"unsafe task id {task!r}; nothing recorded")
    if os.path.exists(args.ledger_dir) and not os.path.isdir(args.ledger_dir):
        fail(3, f"ledger path {args.ledger_dir!r} is not a directory; nothing recorded")

    res = git(directory, "rev-parse", "--abbrev-ref", "HEAD")
    if res.returncode != 0:
        fail(3, f"cannot read the branch of {directory!r}: {res.stderr.strip()}")
    actual = res.stdout.strip()
    if actual != args.branch:
        fail(3, f"{directory!r} is on {actual!r}, not {args.branch!r}; nothing recorded")

    head = commit_sha(directory, "HEAD")
    base = commit_sha(directory, args.from_)
    if not is_ancestor(directory, base, head):
        fail(3, f"{args.from_} is not an ancestor of HEAD in {directory!r}; nothing recorded")
    res = git(directory, "rev-list", "--reverse", f"{base}..{head}")
    if res.returncode != 0:
        fail(1, f"git rev-list failed in {directory!r}: {res.stderr.strip()}")
    commits = res.stdout.split()
    if not commits and args.settled is None:
        fail(3, f"no commits in {args.from_}..HEAD; nothing recorded")
    for ref in args.commit:
        sha = commit_sha(directory, ref)
        if sha not in commits:
            fail(3, f"commit {ref!r} is not in {args.from_}..HEAD; nothing recorded")

    res = git(directory, "diff", "--shortstat", base, head)
    if res.returncode != 0:
        fail(1, f"git diff --shortstat failed in {directory!r}: {res.stderr.strip()}")
    changed = sum(int(n) for n, _ in SHORTSTAT.findall(res.stdout))

    ledger = os.path.join(HERE, "ledger")
    for task in args.task:
        if args.settled is None:
            event = {"task": task, "event": "committed", "base": base, "head": head, "commits": commits}
        else:
            event = {"task": task, "event": "settled", "outcome": args.settled,
                     "base": base, "head": head, "commits": commits}
        res = subprocess.run(
            [sys.executable, ledger, "append", args.ledger_dir, args.lane, json.dumps(event)], env=ENV
        )
        if res.returncode != 0:
            sys.exit(res.returncode)

    print(json.dumps({"base": base, "head": head, "changed_lines": changed, "commits": commits,
                      "branch": args.branch}))


if __name__ == "__main__":
    main(sys.argv[1:])
