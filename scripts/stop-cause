#!/usr/bin/env python3
"""Tell a usage-limit stop from other agent deaths in a launch's log.

usage:
  python3 stop-cause TRANSCRIPT_DIR

TRANSCRIPT_DIR is the launch's transcript dir (wf_<id>, live or archived);
a Git Bash /c/... path works on Windows. stop-cause reads the launch's
workflow result file, found as run-report and archive-run find it
(_shell.result_paths: <session>/workflows/<name>.json for a transcript dir
at <session>/subagents/workflows/<name>, then <TRANSCRIPT_DIR>.json; the
first of them that is a readable JSON object is used), and its top-level
"logs" list. It prints one line:

  {"usage_limit": true|false, "resets": "<text>"|null, "lines": N}

lines counts the log lines in which the Workflow tool reports that an
agent call failed on a usage limit: "[<label>] failed: ..." lines whose
text matches a pattern in LIMIT_PATTERNS. Other log lines (the engine's own,
which can quote an agent's text) are never counted. usage_limit is lines > 0.
resets is the text after "resets " in the first counted line that has one
(for example "11:20pm (America/Los_Angeles)"), else null; it is never turned
into an absolute time (Python 3.8 and Windows have no time-zone data).
Wording no pattern knows reads as usage_limit false.

Exit codes: 0 with the line; 3 with "stop-cause: <reason>" on stderr when
no readable result file or no "logs" list is found (or a Git Bash path
cannot be converted); 2 on a usage error. It is read-only: it never writes
a file.
"""
import json
import os
import re
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _shell  # noqa: E402

USAGE = "usage: stop-cause TRANSCRIPT_DIR"

# The known usage-limit failures, one entry per wording: (line, resets).
# line matches a whole "[<label>] failed: ..." log line; resets, applied to
# a matching line, captures the reset time and zone. The real texts:
#   sc1: [CR5 review] failed: You've hit your session limit \u00b7 resets
#        11:20pm (America/Los_Angeles)
#   m1a: [I3 implement] failed: You've hit your session limit \u00b7 resets
#        5am (America/Los_Angeles)
# The first entry whose line pattern matches decides for that line.
LIMIT_PATTERNS = (
    (re.compile(r"^\[[^\]]+\] failed: .*\bhit your (?:\w+ )?limit\b"),
     re.compile(r"resets (.+?)\s*$")),
)


class Unreadable(Exception):
    """No readable result file or logs list; the message is the reason."""


def read_logs(transcript_dir):
    """The logs list of the transcript dir's workflow result file."""
    problems = []
    for path in _shell.result_paths(transcript_dir):
        if not os.path.isfile(path):
            continue
        try:
            with open(path, encoding="utf-8") as f:
                data = json.load(f)
        except (OSError, ValueError) as e:
            problems.append("cannot read " + path + ": " + str(e))
            continue
        if not isinstance(data, dict):
            problems.append("not a JSON object: " + path)
            continue
        logs = data.get("logs")
        if not isinstance(logs, list):
            raise Unreadable("no logs list in " + path)
        return logs
    if problems:
        raise Unreadable("; ".join(problems))
    raise Unreadable("no workflow result file for " + transcript_dir + " (looked for "
                     + ", ".join(_shell.result_paths(transcript_dir)) + ")")


def classify(logs):
    """The {"usage_limit", "resets", "lines"} verdict for a logs list."""
    lines = 0
    resets = None
    for entry in logs:
        if not isinstance(entry, str):
            continue
        for line_re, resets_re in LIMIT_PATTERNS:
            if line_re.search(entry):
                lines += 1
                if resets is None:
                    m = resets_re.search(entry)
                    if m:
                        resets = m.group(1)
                break
    return {"usage_limit": lines > 0, "resets": resets, "lines": lines}


def main(argv):
    _shell.setup_io()
    args = argv[1:]
    if len(args) != 1:
        print(USAGE, file=sys.stderr)
        return 2
    try:
        transcript_dir = _shell.native_path(args[0])
        logs = read_logs(transcript_dir)
    except (_shell.BashNotFound, Unreadable) as e:
        print("stop-cause: " + str(e), file=sys.stderr)
        return 3
    print(json.dumps(classify(logs)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
