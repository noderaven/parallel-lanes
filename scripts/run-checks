#!/usr/bin/env python3
"""Run a checkout's project commands one by one and keep every exit status.

usage: run-checks DIR [--out FILE] [--root ROOT] --cmd GROUP COMMAND [--cmd ...]

Each COMMAND runs with bash -c in DIR (the bash _shell.find_bash resolves:
Git Bash on Windows, never the WSL launcher), in the given order, and every
one runs even after a failure: one group's failure never hides another's.
Nothing from the commands reaches run-checks' own stdout or stderr (an
agent's shell call captures both whole): the Nth command's stdout and stderr
go together to one log file, <FILE stem>.N.log beside FILE with --out, else
N.log in a new temporary directory that run-checks leaves for the caller to
read and then remove (the directory each result's log names). stdout is one
JSON line, also written to FILE with --out (with --root, the run's ledger
directory, FILE and its logs must resolve inside ROOT; --root does nothing
without --out):
  {"checkout": DIR, "branch": <abbrev-ref>, "head": <full sha checked>,
   "results": [{"group": GROUP, "command": COMMAND, "exit": <code>,
                "started": <UTC ISO 8601 with milliseconds when it began,
                            e.g. 2026-10-10T07:00:00.123Z>,
                "ended": <the same stamp when it finished>,
                "duration_s": <seconds it ran, from time.monotonic(),
                               rounded to 0.001>,
                "log": <absolute path of its log>,
                "tail": <its last 20 lines, joined with \\n; at most the
                         last 4096 characters of them, starting with
                         "[truncated] " when cut>}],
   "ok": <true when every exit is 0>, "clean": <true when the after
   snapshot is empty>,
   "tracked_before": [<the before snapshot's lines that do not start with
                       "?? ": the tracked files already edited, staged,
                       renamed, deleted or conflicted; [] when none>],
   "tracked_after": [<the same from the after snapshot; [] when none>],
   "untracked_before": [<the before snapshot's lines that start with "?? ":
                         every untracked file that is not ignored; [] when
                         none>],
   "untracked_after": [<the same from the after snapshot; [] when none>]}

The snapshots are git status --porcelain --untracked-files=all, taken once
before the first command and once after the last: two status calls per run
on a clean checkout. When a snapshot holds a tracked line, the tracked list is
read with --untracked-files=no instead (one more call), since =all also
reports a submodule that only holds untracked files as modified; so the
tracked lines always equal those of --untracked-files=no. clean ignores a
status.showUntrackedFiles=no setting: an untracked file always makes it
false.

head is read before the commands run and again after; if a command moved
HEAD the result says so in "head_after" and ok is false (a check must not
change the code it checks).

--descends-from SHA (7 to 40 hex digits, else a usage error): before any
command, git merge-base --is-ancestor SHA HEAD runs. When SHA is an ancestor
of HEAD the JSON gains "descends_from": {"sha": SHA, "ok": true} and the
commands run. Otherwise no command runs: the JSON has every field above with
"results": [], "ok": false, the after lists equal to the before ones, and
"descends_from": {"sha": SHA, "ok": false}; it is written to FILE as usual and
run-checks exits 1. The verify step uses it to accept a repair's head only
when it descends from the revision the repair started at.

On Windows DIR, FILE and ROOT may be given in any form (C:\\x, /c/x, /tmp/x)
and are used, like each log path, in the C:/... form. FILE is written as UTF-8 with LF line
endings.

GIT_DIR, GIT_WORK_TREE, GIT_INDEX_FILE, GIT_OBJECT_DIRECTORY and
GIT_COMMON_DIR are removed from the environment.

Exit 0 when ok; 1 when a command failed or moved HEAD; 2 on usage error; 3
when DIR is not a git checkout, FILE or a log is outside ROOT (or is a
symlink), or no bash can be found
(the message names CLAUDE_CODE_GIT_BASH_PATH; no command runs).
"""

import io
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _shell  # noqa: E402

GIT_REDIRECTS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
                 "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR")
ENV = {k: v for k, v in os.environ.items() if k not in GIT_REDIRECTS}
TAIL_LINES = 20
TAIL_CHARS = 4096
TAIL_WINDOW = 65536  # bytes read from the end of a log for its tail
TRUNCATED = "[truncated] "
SHA = re.compile(r"^[0-9a-f]{7,40}$")
USAGE = ("usage: run-checks DIR [--out FILE] [--root ROOT] [--descends-from SHA] "
         "--cmd GROUP COMMAND [--cmd GROUP COMMAND ...]")


def fail(code, message):
    print(f"run-checks: {message}", file=sys.stderr)
    sys.exit(code)


def git(directory, *args):
    return subprocess.run(["git", "-C", directory, *args], capture_output=True, text=True, encoding="utf-8",
                          errors="surrogateescape", env=ENV)


def contained(path, root):
    root = os.path.realpath(root)
    path = os.path.abspath(path)
    head, tail = path, []
    while not os.path.lexists(head) and head != os.path.dirname(head):
        head, name = os.path.split(head)
        tail.insert(0, name)
    resolved = os.path.join(os.path.realpath(head), *tail)
    return os.path.commonpath([resolved, root]) == root


def parse(argv):
    if not argv or not argv[0] or argv[0].startswith("-"):
        fail(2, USAGE)
    directory, rest = _shell.native_path(argv[0]), argv[1:]
    out = root = descends = None
    cmds = []
    while rest:
        if rest[0] == "--cmd" and len(rest) >= 3 and rest[1] and rest[2]:
            cmds.append((rest[1], rest[2]))
            rest = rest[3:]
        elif rest[0] in ("--out", "--root") and len(rest) >= 2 and rest[1]:
            if rest[0] == "--out":
                out = _shell.native_path(rest[1])
            else:
                root = _shell.native_path(rest[1])
            rest = rest[2:]
        elif rest[0] == "--descends-from" and len(rest) >= 2 and SHA.match(rest[1]):
            descends = rest[1]
            rest = rest[2:]
        else:
            fail(2, USAGE)
    return directory, out, root, cmds, descends


def head_of(directory):
    res = git(directory, "rev-parse", "--verify", "HEAD^{commit}")
    if res.returncode != 0:
        fail(3, f"{directory!r} is not a git checkout with a commit: {res.stderr.strip()}")
    return res.stdout.strip()


def status_of(directory, *args):
    """The stdout of git status --porcelain; a status git could not read
    (index.lock contention, a damaged index) ends the run, so it is never
    taken for a clean checkout."""
    res = git(directory, "status", "--porcelain", *args)
    if res.returncode != 0:
        fail(3, f"git status failed in {directory!r}: {res.stderr.strip()}")
    return res.stdout


def snapshot(directory):
    """The lines git status --porcelain --untracked-files=all prints, without
    empty lines or the line end but with the leading status columns."""
    out = status_of(directory, "--untracked-files=all")
    lines = (line.rstrip("\r\n") for line in out.split("\n"))
    return [line for line in lines if line]


def tracked_lines(directory, lines):
    """The tracked-file lines, as git status --porcelain --untracked-files=no
    prints them. A snapshot with no tracked line has none, so no further call
    is needed; otherwise they are read with --untracked-files=no, because
    --untracked-files=all also reports a submodule that only holds untracked
    files as modified (" M sub"), which =no does not."""
    if all(line.startswith("?? ") for line in lines):
        return []
    out = status_of(directory, "--untracked-files=no")
    return [line for line in (raw.rstrip("\r\n") for raw in out.split("\n")) if line]


def untracked_lines(lines):
    """The snapshot lines for untracked files (those starting with "?? ")."""
    return [line for line in lines if line.startswith("?? ")]


def descends_from(directory, sha):
    """Whether sha is an ancestor of HEAD (git merge-base --is-ancestor); an
    unknown sha is not."""
    return git(directory, "merge-base", "--is-ancestor", sha, "HEAD").returncode == 0


def log_paths(out, count):
    """The absolute log path of each of count commands, beside out when given."""
    if count == 0:
        return []
    if out is not None:
        parent = os.path.dirname(os.path.abspath(out))
        stem = os.path.splitext(os.path.basename(out))[0]
        os.makedirs(parent, exist_ok=True)
    else:
        parent, stem = tempfile.mkdtemp(prefix="run-checks-"), ""
    return [_shell.native_path(os.path.join(parent, f"{stem}.{n}.log" if stem else f"{n}.log"))
            for n in range(1, count + 1)]


def utc_stamp():
    """The current UTC time as ISO 8601 with milliseconds and a Z suffix."""
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def tail_of(path):
    """The last TAIL_LINES lines of the file at path, joined with \\n, kept to
    the last TAIL_CHARS characters: a command that prints one long line must
    not put it all back on stdout. Only the last TAIL_WINDOW bytes are read;
    a tail cut by either limit starts with TRUNCATED."""
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        start = max(0, f.tell() - TAIL_WINDOW)
        f.seek(start)
        data = f.read()
    lines = list(io.StringIO(data.decode("utf-8", errors="replace"), newline=""))
    # With start > 0 the first line may be a fragment of a longer one.
    cut = start > 0 and len(lines) <= TAIL_LINES
    tail = "\n".join(line.rstrip("\r\n") for line in lines[-TAIL_LINES:])
    if len(tail) > TAIL_CHARS:
        tail, cut = tail[-TAIL_CHARS:], True
    return TRUNCATED + tail if cut else tail


def main(argv):
    _shell.setup_io()
    try:
        run(*parse(argv))
    except _shell.BashNotFound as e:
        fail(3, str(e))


def run(directory, out, root, cmds, descends=None):
    if out is not None and root is not None and (os.path.islink(out) or not contained(out, root)):
        fail(3, f"output path {out!r} is outside {root!r}")
    if cmds:
        # Found before anything runs: a missing bash fails no check halfway.
        _shell.find_bash()
    head = head_of(directory)
    branch = git(directory, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    logs = log_paths(out, len(cmds))
    if out is not None and root is not None:
        # Beside FILE; without --out they are in a new temporary directory.
        for log in logs:
            if os.path.islink(log) or not contained(log, root):
                fail(3, f"log path {log!r} is outside {root!r}")
    before = snapshot(directory)
    tracked_before = tracked_lines(directory, before)
    lineage = None
    if descends is not None:
        lineage = {"sha": descends, "ok": descends_from(directory, descends)}
        if not lineage["ok"]:
            # Not a descendant: no command runs, and the report says why.
            report = {"checkout": directory, "branch": branch, "head": head, "results": [], "ok": False,
                      "clean": not before,
                      "tracked_before": tracked_before, "tracked_after": tracked_before,
                      "untracked_before": untracked_lines(before), "untracked_after": untracked_lines(before),
                      "descends_from": lineage}
            emit(report, out)
    results = []
    for (group, command), log in zip(cmds, logs):
        with open(log, "wb") as f:
            started, t0 = utc_stamp(), time.monotonic()
            res = subprocess.run(_shell.bash_argv("-c", command), cwd=directory, env=ENV,
                                 stdout=f, stderr=subprocess.STDOUT)
            duration, ended = time.monotonic() - t0, utc_stamp()
        results.append({"group": group, "command": command, "exit": res.returncode,
                        "started": started, "ended": ended, "duration_s": round(duration, 3),
                        "log": log, "tail": tail_of(log)})
    finish = snapshot(directory)
    tracked_after = tracked_lines(directory, finish)
    after = head_of(directory)
    report = {"checkout": directory, "branch": branch, "head": head, "results": results,
              "ok": all(r["exit"] == 0 for r in results) and after == head, "clean": not finish,
              "tracked_before": tracked_before, "tracked_after": tracked_after,
              "untracked_before": untracked_lines(before), "untracked_after": untracked_lines(finish)}
    if after != head:
        report["head_after"] = after
    if lineage is not None:
        report["descends_from"] = lineage
    emit(report, out)


def emit(report, out):
    """Write report to out (when given), print it as one line, and exit 0 when
    it is ok, else 1."""
    line = json.dumps(report)
    if out is not None:
        parent = os.path.dirname(out)
        if parent:
            os.makedirs(parent, exist_ok=True)
        _shell.write_text(out, line + "\n")
    print(line)
    sys.exit(0 if report["ok"] else 1)


if __name__ == "__main__":
    main(sys.argv[1:])
