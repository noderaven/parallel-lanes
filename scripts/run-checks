#!/usr/bin/env python3
"""Run a checkout's project commands one by one and keep every exit status.

usage: run-checks DIR [--out FILE] [--root ROOT] --cmd GROUP COMMAND [--cmd ...]

Each COMMAND runs with bash -c in DIR (the bash _shell.find_bash resolves:
Git Bash on Windows, never the WSL launcher), in the given order, and every
one runs even after a failure: one group's failure never hides another's.
Command output goes to stderr. stdout is one JSON line, also written to FILE with
--out (FILE must resolve inside ROOT with --root, the run's ledger directory):
  {"checkout": DIR, "branch": <abbrev-ref>, "head": <full sha checked>,
   "results": [{"group": GROUP, "command": COMMAND, "exit": <code>}],
   "ok": <true when every exit is 0>, "clean": <true when git status
   --porcelain printed nothing after the commands>}

head is read before the commands run and again after; if a command moved
HEAD the result says so in "head_after" and ok is false (a check must not
change the code it checks).

On Windows DIR, FILE and ROOT may be given in any form (C:\\x, /c/x, /tmp/x)
and are used in the C:/... form. FILE is written as UTF-8 with LF line
endings.

GIT_DIR, GIT_WORK_TREE, GIT_INDEX_FILE, GIT_OBJECT_DIRECTORY and
GIT_COMMON_DIR are removed from the environment.

Exit 0 when ok; 1 when a command failed or moved HEAD; 2 on usage error; 3
when DIR is not a git checkout, FILE is outside ROOT, or no bash can be found
(the message names CLAUDE_CODE_GIT_BASH_PATH; no command runs).
"""

import json
import os
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _shell  # noqa: E402

GIT_REDIRECTS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE",
                 "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR")
ENV = {k: v for k, v in os.environ.items() if k not in GIT_REDIRECTS}
USAGE = "usage: run-checks DIR [--out FILE] [--root ROOT] --cmd GROUP COMMAND [--cmd GROUP COMMAND ...]"


def fail(code, message):
    print(f"run-checks: {message}", file=sys.stderr)
    sys.exit(code)


def git(directory, *args):
    return subprocess.run(["git", "-C", directory, *args], capture_output=True, text=True, env=ENV)


def contained(path, root):
    root = os.path.realpath(root)
    path = os.path.abspath(path)
    head, tail = path, []
    while not os.path.lexists(head) and head != os.path.dirname(head):
        head, name = os.path.split(head)
        tail.insert(0, name)
    resolved = os.path.join(os.path.realpath(head), *tail)
    return os.path.commonpath([resolved, root]) == root


def parse(argv):
    if not argv or not argv[0] or argv[0].startswith("-"):
        fail(2, USAGE)
    directory, rest = _shell.native_path(argv[0]), argv[1:]
    out = root = None
    cmds = []
    while rest:
        if rest[0] == "--cmd" and len(rest) >= 3 and rest[1] and rest[2]:
            cmds.append((rest[1], rest[2]))
            rest = rest[3:]
        elif rest[0] in ("--out", "--root") and len(rest) >= 2 and rest[1]:
            if rest[0] == "--out":
                out = _shell.native_path(rest[1])
            else:
                root = _shell.native_path(rest[1])
            rest = rest[2:]
        else:
            fail(2, USAGE)
    return directory, out, root, cmds


def head_of(directory):
    res = git(directory, "rev-parse", "--verify", "HEAD^{commit}")
    if res.returncode != 0:
        fail(3, f"{directory!r} is not a git checkout with a commit: {res.stderr.strip()}")
    return res.stdout.strip()


def main(argv):
    _shell.setup_io()
    try:
        run(*parse(argv))
    except _shell.BashNotFound as e:
        fail(3, str(e))


def run(directory, out, root, cmds):
    if out is not None and root is not None and (os.path.islink(out) or not contained(out, root)):
        fail(3, f"output path {out!r} is outside {root!r}")
    if cmds:
        # Found before anything runs: a missing bash fails no check halfway.
        _shell.find_bash()
    head = head_of(directory)
    branch = git(directory, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    results = []
    for group, command in cmds:
        res = subprocess.run(_shell.bash_argv("-c", command), cwd=directory, env=ENV,
                             stdout=sys.stderr, stderr=sys.stderr)
        results.append({"group": group, "command": command, "exit": res.returncode})
    after = head_of(directory)
    clean = git(directory, "status", "--porcelain").stdout == ""
    report = {"checkout": directory, "branch": branch, "head": head, "results": results,
              "ok": all(r["exit"] == 0 for r in results) and after == head, "clean": clean}
    if after != head:
        report["head_after"] = after
    line = json.dumps(report)
    if out is not None:
        parent = os.path.dirname(out)
        if parent:
            os.makedirs(parent, exist_ok=True)
        _shell.write_text(out, line + "\n")
    print(line)
    sys.exit(0 if report["ok"] else 1)


if __name__ == "__main__":
    main(sys.argv[1:])
