#!/usr/bin/env python3
"""Extract one task's section from a plan into a brief file.

usage: task-brief PLAN TASK_ID OUT

The section starts at the first heading matching '#+ Task <TASK_ID>' (the id
matched literally and as a whole token, so 'Task 1' does not match 'Task 10',
'Task 1a', or 'Task 1.5'). It ends before the next '#+ Task ' heading of the
same or higher level, or before any heading of a strictly higher level.
Headings inside fenced code blocks are ignored.

Exit 0 on success; 2 on usage error; 3 if the plan is unreadable, the heading
is missing or duplicated, or the section has no content. Nothing is written
unless the exit is 0.
"""

import os
import re
import sys

FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
HEADING = re.compile(r"^(#{1,6})\s")
TASK_HEADING = re.compile(r"^(#{1,6})\s+Task\s")


def fail(code, message):
    print(f"task-brief: {message}", file=sys.stderr)
    sys.exit(code)


def heading_lines(lines):
    """Yield (index, level, is_task, line) for headings outside fenced code."""
    fence = None
    for i, line in enumerate(lines):
        m = FENCE.match(line)
        if m:
            marker = m.group(1)
            if fence is None:
                fence = marker
            elif marker[0] == fence[0] and len(marker) >= len(fence) and not line.strip()[len(marker):]:
                fence = None
            continue
        if fence is not None:
            continue
        h = HEADING.match(line)
        if h:
            yield i, len(h.group(1)), bool(TASK_HEADING.match(line)), line


def extract(text, task_id):
    lines = text.splitlines()
    start_re = re.compile(r"^#{1,6}\s+Task\s+" + re.escape(task_id) + r"(?![\w.-])")
    headings = list(heading_lines(lines))
    starts = [(i, level) for i, level, _, line in headings if start_re.match(line)]
    if not starts:
        fail(3, f"no heading for task {task_id!r}")
    if len(starts) > 1:
        fail(3, f"task {task_id!r} has {len(starts)} headings; refusing to guess")
    start, level = starts[0]
    end = len(lines)
    for i, lvl, is_task, _ in headings:
        if i <= start:
            continue
        if lvl < level or (is_task and lvl == level):
            end = i
            break
    section = lines[start:end]
    while section and not section[-1].strip():
        section.pop()
    if not any(line.strip() for line in section[1:]):
        fail(3, f"task {task_id!r} section is empty")
    return "\n".join(section) + "\n"


def main(argv):
    if len(argv) != 3 or not all(argv):
        fail(2, "usage: task-brief PLAN TASK_ID OUT")
    plan, task_id, out = argv
    try:
        with open(plan, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        fail(3, f"cannot read plan {plan!r}: {e}")
    brief = extract(text, task_id)
    parent = os.path.dirname(out)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        f.write(brief)


if __name__ == "__main__":
    main(sys.argv[1:])
